{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matsurfer/audiences",
  "title": "Para quién es",
  "description": "Cuatro tipos de equipo con icono, en paneles que se abren uno a uno.",
  "category": "matsurfer",
  "icon": "groups",
  "textdomain": "matsurfer",
  "supports": {
    "html": false,
    "className": false,
    "customClassName": false,
    "reusable": false,
    "lock": false,
    "renaming": false
  },
  "attributes": {
    "sectionId": {
      "type": "string",
      "default": "who-is-it-for"
    },
    "headingId": {
      "type": "string",
      "default": "audiences-title"
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "viewScript": "file:./view.js",
  "matsurfer": {
    "fields": [
      {
        "key": "kicker",
        "type": "text",
        "label": "Etiqueta superior",
        "help": "Texto pequeño en mayúsculas encima del título."
      },
      {
        "key": "title",
        "type": "text",
        "requiredGroup": "section",
        "label": "Título"
      },
      {
        "key": "groups",
        "type": "repeater",
        "requiredGroup": "section",
        "label": "Tipos de equipo",
        "itemLabel": "Equipo",
        "fields": [
          {
            "key": "icon",
            "type": "select",
            "label": "Icono",
            "options": [
              {
                "value": "surface",
                "label": "Grupos académicos"
              },
              {
                "value": "lab",
                "label": "Nuevos en superficies"
              },
              {
                "value": "insitu",
                "label": "I+D corporativo"
              },
              {
                "value": "modularity",
                "label": "Socios de equipamiento"
              }
            ],
            "help": "Icono de la marca que acompaña a este tipo de equipo."
          },
          {
            "key": "title",
            "type": "text",
            "label": "Título"
          },
          {
            "key": "text",
            "type": "textarea",
            "label": "Texto",
            "rows": 3
          }
        ],
        "min": 4,
        "max": 4,
        "titleField": "title",
        "help": "En ordenador se abre un panel cada vez (el primero al cargar); en móvil se ven los cuatro abiertos."
      }
    ]
  }
}
