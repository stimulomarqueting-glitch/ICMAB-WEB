{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matsurfer/parameters",
  "title": "Parámetros",
  "description": "Tarjetas con el símbolo y el nombre de cada parámetro.",
  "category": "matsurfer",
  "icon": "performance",
  "textdomain": "matsurfer",
  "supports": {
    "html": false,
    "className": false,
    "customClassName": false,
    "reusable": false,
    "lock": false,
    "renaming": false
  },
  "attributes": {
    "sectionId": {
      "type": "string",
      "default": "parameters"
    },
    "headingId": {
      "type": "string",
      "default": "params-title"
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "matsurfer": {
    "fields": [
      {
        "key": "kicker",
        "type": "text",
        "label": "Etiqueta superior",
        "help": "Texto corto que aparece en mayúsculas encima del título."
      },
      {
        "key": "title",
        "type": "text",
        "requiredGroup": "section",
        "label": "Título"
      },
      {
        "key": "lead",
        "type": "textarea",
        "label": "Texto",
        "rows": 3,
        "help": "Texto debajo del título."
      },
      {
        "key": "items",
        "type": "repeater",
        "requiredGroup": "section",
        "label": "Parámetros",
        "itemLabel": "Parámetro",
        "fields": [
          {
            "key": "symbol",
            "type": "text",
            "label": "Símbolo",
            "help": "Una letra o símbolo corto (d, m, P, T, t…)."
          },
          {
            "key": "label",
            "type": "text",
            "label": "Nombre"
          }
        ],
        "min": 1,
        "max": 8,
        "titleField": "label",
        "help": "La primera tarjeta aparece destacada en color violeta."
      }
    ]
  }
}
