{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matsurfer/apps-teaser",
  "title": "Aplicaciones (inicio)",
  "description": "Isotipo con los cinco campos de aplicación y accesos a cada aplicación.",
  "category": "matsurfer",
  "icon": "screenoptions",
  "textdomain": "matsurfer",
  "supports": {
    "html": false,
    "className": false,
    "customClassName": false,
    "reusable": false,
    "lock": false,
    "renaming": false
  },
  "attributes": {
    "sectionId": {
      "type": "string",
      "default": "applications"
    },
    "headingId": {
      "type": "string",
      "default": "apps-teaser-title"
    },
    "ctaSource": {
      "type": "string",
      "default": "home-applications"
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "viewScript": "file:./view.js",
  "matsurfer": {
    "fields": [
      {
        "key": "kicker",
        "type": "text",
        "label": "Etiqueta superior",
        "help": "Texto corto en mayúsculas encima del título."
      },
      {
        "key": "title",
        "type": "text",
        "required": true,
        "label": "Título"
      },
      {
        "key": "lead",
        "type": "textarea",
        "label": "Texto",
        "rows": 3
      },
      {
        "key": "cta",
        "type": "link",
        "label": "Botón"
      },
      {
        "type": "panel",
        "label": "Isotipo"
      },
      {
        "key": "isotypeCaption",
        "type": "text",
        "label": "Pie del isotipo",
        "help": "Frase corta debajo del dibujo."
      },
      {
        "key": "isotypeAlt",
        "type": "textarea",
        "label": "Descripción del dibujo (accesibilidad)",
        "rows": 2,
        "help": "Lo que leen los lectores de pantalla en lugar del dibujo."
      },
      {
        "key": "isotypeLabels",
        "type": "list",
        "label": "Etiquetas del isotipo",
        "itemLabel": "Etiqueta",
        "min": 5,
        "max": 5,
        "help": "Cinco campos, en este orden: electrónica orgánica, sensores, perovskitas, recubrimientos y SPM. En el móvil no se muestran (los accesos de debajo ya nombran cada campo)."
      },
      {
        "type": "panel",
        "label": "Accesos a las aplicaciones"
      },
      {
        "type": "notice",
        "text": "Los accesos bajo el isotipo salen automáticamente de las aplicaciones publicadas.",
        "admin": "edit.php?post_type=mats_application",
        "linkLabel": "Editar aplicaciones"
      }
    ]
  }
}
