{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matsurfer/product-teaser",
  "title": "Presentación del producto (inicio)",
  "description": "Texto con botón y una foto del dispositivo.",
  "category": "matsurfer",
  "icon": "align-pull-right",
  "textdomain": "matsurfer",
  "supports": {
    "html": false,
    "className": false,
    "customClassName": false,
    "reusable": false,
    "lock": false,
    "renaming": false
  },
  "attributes": {
    "sectionId": {
      "type": "string",
      "default": "technology"
    },
    "headingId": {
      "type": "string",
      "default": "product-teaser-title"
    },
    "ctaSource": {
      "type": "string",
      "default": "home-product"
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "matsurfer": {
    "fields": [
      {
        "key": "kicker",
        "type": "text",
        "label": "Etiqueta superior",
        "help": "Texto corto en mayúsculas encima del título."
      },
      {
        "key": "title",
        "type": "text",
        "label": "Título"
      },
      {
        "key": "lead",
        "type": "textarea",
        "label": "Texto",
        "rows": 4
      },
      {
        "key": "cta",
        "type": "link",
        "label": "Botón"
      },
      {
        "key": "photo",
        "type": "image",
        "label": "Foto",
        "help": "Se recorta en formato 4:3. Al pasar el ratón, la foto se inclina un poco."
      }
    ]
  }
}
