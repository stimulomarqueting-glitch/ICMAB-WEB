{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matsurfer/product-teaser",
  "title": "Presentación del producto (inicio)",
  "description": "Texto con botón y una foto del dispositivo.",
  "category": "matsurfer",
  "icon": "align-pull-right",
  "textdomain": "matsurfer",
  "supports": {
    "html": false,
    "className": false,
    "customClassName": false,
    "reusable": false,
    "lock": false,
    "renaming": false
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "matsurfer": {
    "fields": [
      {
        "key": "kicker",
        "type": "text",
        "label": "Etiqueta superior"
      },
      {
        "key": "title",
        "type": "text",
        "label": "Título"
      },
      {
        "key": "lead",
        "type": "textarea",
        "label": "Texto",
        "rows": 4
      },
      {
        "key": "cta",
        "type": "link",
        "label": "Botón"
      },
      {
        "key": "photo",
        "type": "image",
        "label": "Foto"
      }
    ]
  }
}
