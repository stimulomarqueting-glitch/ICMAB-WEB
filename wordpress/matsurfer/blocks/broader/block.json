{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matsurfer/broader",
  "title": "Banda oscura destacada",
  "description": "Mensaje destacado sobre fondo oscuro.",
  "category": "matsurfer",
  "icon": "format-quote",
  "textdomain": "matsurfer",
  "supports": {
    "html": false,
    "className": false,
    "customClassName": false,
    "reusable": false,
    "lock": false,
    "renaming": false
  },
  "attributes": {
    "headingId": {
      "type": "string",
      "default": "broader-title"
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "matsurfer": {
    "fields": [
      {
        "key": "kicker",
        "type": "text",
        "label": "Etiqueta superior",
        "help": "Texto corto en mayúsculas encima del título."
      },
      {
        "key": "title",
        "type": "text",
        "label": "Título"
      },
      {
        "key": "text",
        "type": "textarea",
        "label": "Texto",
        "rows": 4
      }
    ]
  }
}
