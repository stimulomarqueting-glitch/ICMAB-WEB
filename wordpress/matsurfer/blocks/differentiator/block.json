{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matsurfer/differentiator",
  "title": "Diferencial clave",
  "description": "Bloque destacado con la distancia fuente–sustrato y sus ventajas.",
  "category": "matsurfer",
  "icon": "star-filled",
  "textdomain": "matsurfer",
  "supports": {
    "html": false,
    "className": false,
    "customClassName": false,
    "reusable": false,
    "lock": false,
    "renaming": false
  },
  "attributes": {
    "sectionId": {
      "type": "string",
      "default": "differentiator"
    },
    "headingId": {
      "type": "string",
      "default": "diff-title"
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "matsurfer": {
    "fields": [
      {
        "key": "kicker",
        "type": "text",
        "label": "Etiqueta superior",
        "help": "Texto corto que aparece en mayúsculas encima del título."
      },
      {
        "key": "title",
        "type": "text",
        "label": "Título destacado",
        "help": "La ventaja principal. Aparece grande dentro del recuadro blanco, junto a la «d»."
      },
      {
        "key": "text",
        "type": "textarea",
        "label": "Texto destacado",
        "rows": 3,
        "help": "Explicación breve de la ventaja principal."
      },
      {
        "key": "features",
        "type": "repeater",
        "label": "Ventajas",
        "itemLabel": "Ventaja",
        "fields": [
          {
            "key": "title",
            "type": "text",
            "label": "Título"
          },
          {
            "key": "text",
            "type": "textarea",
            "label": "Texto",
            "rows": 2
          }
        ],
        "min": 1,
        "max": 9,
        "titleField": "title",
        "help": "Ventajas que aparecen debajo del recuadro, en columnas de tres."
      }
    ]
  }
}
