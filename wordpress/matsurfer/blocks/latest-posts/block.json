{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matsurfer/latest-posts",
  "title": "Últimas noticias",
  "description": "Las noticias más recientes del idioma de la página. No se muestra si aún no hay noticias.",
  "category": "matsurfer",
  "icon": "admin-post",
  "textdomain": "matsurfer",
  "supports": {
    "html": false,
    "className": false,
    "customClassName": false,
    "reusable": false,
    "lock": false,
    "renaming": false
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "matsurfer": {
    "fields": [
      {
        "key": "kicker",
        "type": "text",
        "label": "Etiqueta superior"
      },
      {
        "key": "title",
        "type": "text",
        "label": "Título"
      },
      {
        "key": "count",
        "type": "select",
        "label": "Cuántas noticias",
        "options": [
          {
            "value": "3",
            "label": "3"
          },
          {
            "value": "6",
            "label": "6"
          }
        ],
        "default": "3"
      },
      {
        "key": "cta",
        "type": "link",
        "label": "Botón «todas las noticias»"
      }
    ]
  }
}
