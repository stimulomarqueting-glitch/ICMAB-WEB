{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matsurfer/research-validation",
  "title": "Validación y propiedad intelectual",
  "description": "Banda oscura con el texto de validación.",
  "category": "matsurfer",
  "icon": "shield",
  "textdomain": "matsurfer",
  "supports": {
    "html": false,
    "className": false,
    "customClassName": false,
    "reusable": false,
    "lock": false,
    "renaming": false
  },
  "attributes": {
    "sectionId": {
      "type": "string",
      "default": "validation"
    },
    "headingId": {
      "type": "string",
      "default": "validation-title"
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "matsurfer": {
    "fields": [
      {
        "key": "title",
        "type": "text",
        "label": "Título"
      },
      {
        "key": "paragraphs",
        "type": "list",
        "required": true,
        "label": "Párrafos",
        "itemLabel": "Párrafo",
        "min": 1,
        "max": 4,
        "help": "Cada párrafo va en su propio recuadro. Si no hay ningún párrafo, la sección no se muestra."
      }
    ]
  }
}
