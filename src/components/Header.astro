---
/**
 * Site header (v3 liquid glass): logo → home, five-item nav with active
 * state, stable global CTA. Mobile: burger menu, keyboard accessible,
 * focus returned to the toggle on Escape.
 */
import { brand } from '../config/brand';
import { site } from '../content/site';
import BrandMark from './BrandMark.astro';

const { nav, cta, ctaHref, menuOpen, menuClose } = site.header;

/* active state: exact match or a subpath of the item (e.g. /product#faq) */
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href="/" aria-label={`${brand.projectName} — home`}>
      <BrandMark size={30} />
      <span class="wordmark">{brand.projectName}</span>
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul id="main-menu" class="header__menu">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="header__menu-cta">
          <a class="btn" href={ctaHref} data-cta-source="header">{cta}</a>
        </li>
      </ul>
    </nav>

    <a class="btn btn--sm header__cta" href={ctaHref} data-cta-source="header">{cta}</a>

    <button
      class="header__burger"
      type="button"
      aria-expanded="false"
      aria-controls="main-menu"
      data-label-open={menuOpen}
      data-label-close={menuClose}
      aria-label={menuOpen}
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  /* liquid glass navbar (v3) */
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border-bottom: 1px solid var(--glass-border);
    box-shadow: 0 1px 0 rgba(38, 36, 31, 0.04);
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1rem;
    color: var(--ink);
    margin-right: auto;
  }

  .header__logo:hover {
    color: var(--ink);
  }

  .header__menu {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__menu > li > a:not(.btn) {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-body);
  }

  .header__menu > li > a:not(.btn):hover {
    color: var(--ink);
  }

  /* current page: ink + coral underline */
  .header__menu > li > a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
    box-shadow: 0 2px 0 var(--coral);
    padding-bottom: 0.2rem;
  }

  .header__menu-cta {
    display: none;
  }

  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0.6rem;
    background: transparent;
    border: 1px solid var(--silica);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .header__burger span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--ink);
    border-radius: 2px;
    transition: transform var(--dur-base) var(--ease), opacity var(--dur-fast) var(--ease);
  }

  .header__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .header__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .header__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 64rem) {
    .header__burger { display: flex; }

    .header__nav {
      position: absolute;
      inset: var(--header-h) 0 auto 0;
      background: var(--bg-page);
      border-bottom: 1px solid var(--border-subtle);
      display: none;
      box-shadow: var(--shadow-md);
    }

    .header__nav.is-open { display: block; }

    .header__menu {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.75rem 1.5rem 1.5rem;
    }

    .header__menu > li > a:not(.btn) {
      display: block;
      padding: 0.9rem 0.25rem;
      font-size: 1rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .header__menu > li > a[aria-current='page'] {
      box-shadow: none;
      border-left: 3px solid var(--coral);
      padding-left: 0.75rem;
    }

    .header__menu-cta {
      display: block;
      margin-top: 0.5rem;
    }

    .header__menu-cta .btn { width: 100%; }
  }

  /* keep the primary CTA visible on mid-size screens, hide only when tight */
  @media (max-width: 40rem) {
    .header__cta { display: none; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.header__burger');
  const nav = document.querySelector<HTMLElement>('.header__nav');

  if (burger && nav) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute(
        'aria-label',
        open ? burger.dataset.labelClose ?? 'Close menu' : burger.dataset.labelOpen ?? 'Open menu'
      );
      nav.classList.toggle('is-open', open);
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });
  }
</script>
