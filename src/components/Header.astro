---
import { brand } from '../config/brand';
import { getContent, localePath, type Locale } from '../content';
import BrandMark from './BrandMark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const home = `${localePath(locale)}/`;
---

<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href={home} aria-label={`${brand.projectName} — home`}>
      <BrandMark size={30} />
      {brand.projectName}
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul id="main-menu" class="header__menu">
        {t.header.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li class="header__menu-cta">
          <a class="btn" href="#waitlist" data-cta-source="header">{t.header.cta}</a>
        </li>
      </ul>
    </nav>

    <a class="btn btn--sm header__cta" href="#waitlist" data-cta-source="header">{t.header.cta}</a>

    <button
      class="header__burger"
      type="button"
      aria-expanded="false"
      aria-controls="main-menu"
      data-label-open={t.header.menuOpen}
      data-label-close={t.header.menuClose}
      aria-label={t.header.menuOpen}
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    background: rgba(248, 246, 243, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-right: auto;
  }

  .header__logo:hover {
    color: var(--ink);
  }

  .header__menu {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__menu > li > a:not(.btn) {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-body);
  }

  .header__menu > li > a:not(.btn):hover {
    color: var(--ink);
  }

  .header__menu-cta {
    display: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0.6rem;
    background: transparent;
    border: 1px solid var(--silica);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .header__burger span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--ink);
    border-radius: 2px;
    transition: transform var(--dur-base) var(--ease), opacity var(--dur-fast) var(--ease);
  }

  .header__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .header__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .header__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 64rem) {
    .header__cta { display: none; }
    .header__burger { display: flex; }

    .header__nav {
      position: absolute;
      inset: var(--header-h) 0 auto 0;
      background: var(--bg-page);
      border-bottom: 1px solid var(--border-subtle);
      display: none;
      box-shadow: var(--shadow-md);
    }

    .header__nav.is-open { display: block; }

    .header__menu {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.75rem 1.5rem 1.5rem;
    }

    .header__menu > li > a:not(.btn) {
      display: block;
      padding: 0.9rem 0.25rem;
      font-size: 1rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .header__menu-cta {
      display: block;
      margin-top: 0.5rem;
    }

    .header__menu-cta .btn { width: 100%; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.header__burger');
  const nav = document.querySelector<HTMLElement>('.header__nav');

  if (burger && nav) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute(
        'aria-label',
        open ? burger.dataset.labelClose ?? 'Close menu' : burger.dataset.labelOpen ?? 'Open menu'
      );
      nav.classList.toggle('is-open', open);
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
