---
import { getContent, type Locale } from '../content';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).audiences;

/* line icons per audience — single-weight technical stroke, one per profile:
   microscope (academic research) · flask (researchers new to surfaces) ·
   building + flask (corporate R&D and testing) · parcel (distributors) */
const icons: Record<string, string> = {
  surface:
    'M12 3.5h5M14.5 3.5v7M11.5 10.5h6M14.5 10.5v3M14.5 13.5a6.5 6.5 0 0 1 6.5 6.5M5 24h18M8.5 20h6.5M10 16.5h.01',
  lab: 'M11 3h6M12.5 3v6.5L7 20a1.3 1.3 0 0 0 1.2 1.8h11.6A1.3 1.3 0 0 0 21 20l-5.5-10.5V3M9.5 15.5h9',
  insitu:
    'M4 24V8.5l7.5-3V24M4 24h20M7.4 12h.01M7.4 15.5h.01M7.4 19h.01M17 10.5h4.5M18.2 10.5v3.6l-2.7 6.2a1 1 0 0 0 .9 1.4h5.7a1 1 0 0 0 .9-1.4l-2.7-6.2v-3.6',
  modularity: 'M5 9.5 14 5l9 4.5v9L14 23l-9-4.5v-9ZM5 9.5 14 14l9-4.5M14 14v9M9.5 7.3l9 4.4',
};
---

<section class="sec hairtop" id="who-is-it-for" aria-labelledby="audiences-title">
  <div class="container">
    <SectionHeader kicker={t.kicker} title={t.title} id="audiences-title" />

    <div class="aud__layout">
      <img
        class="aud__photo reveal"
        src="/img/researcher-device.jpg"
        alt={t.photoAlt}
        width="1000"
        height="563"
        loading="lazy"
      />
      <div class="aud__grid">
      {t.groups.map((g) => (
        <article class="panel aud__card reveal">
          <span class="aud__icon" aria-hidden="true">
            <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={icons[g.icon] ?? icons.lab}></path>
            </svg>
          </span>
          <div>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        </article>
      ))}
      </div>
    </div>

    <div class="aud__ctaline reveal">
      <a class="btn btn--ghost" href="#waitlist" data-cta-source="audiences">{t.ctaButton}</a>
      <span>{t.ctaNote}</span>
    </div>
  </div>
</section>

<style>
  .aud__layout {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 1.5rem;
    margin-top: 2.25rem;
    align-items: stretch;
  }

  .aud__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% center;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .aud__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .aud__card {
    padding: 1.75rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .aud__icon {
    color: var(--coral-dark);
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.15rem;
  }

  .aud__card h3 {
    font-family: var(--font-body);
    font-size: 1.19rem;
  }

  .aud__card p {
    font-size: 0.88rem;
    margin-top: 0.5rem;
  }

  .aud__ctaline {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.25rem;
    flex-wrap: wrap;
  }

  .aud__ctaline span {
    font-size: 0.94rem;
    color: var(--text-body);
  }

  @media (max-width: 56rem) {
    .aud__layout { grid-template-columns: 1fr; }

    .aud__photo {
      aspect-ratio: 16 / 9;
      height: auto;
      object-position: center 20%;
    }

    .aud__grid { grid-template-columns: 1fr; }
  }
</style>
