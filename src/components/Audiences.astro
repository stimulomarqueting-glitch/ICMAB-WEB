---
import { getContent, type Locale } from '../content';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).audiences;

/* line icons per audience, drawn in the system's stroke style */
const icons: Record<string, string> = {
  surface: 'M3 20h22M8 20c3-2.5 4.5-7 10-10.5M18 9.5m-2 0a2 2 0 1 0 4 0 2 2 0 1 0-4 0M7 17.5h.01M11 15h.01',
  lab: 'M11 3h6M12.5 3v6.5L7 20a1.3 1.3 0 0 0 1.2 1.8h11.6A1.3 1.3 0 0 0 21 20l-5.5-10.5V3M9.5 15.5h9',
  insitu: 'M4 14h20M4 14v6h20v-6M9 14V9a5 5 0 0 1 10 0v5M12 20h4',
  modularity: 'M4 4h8v8H4zM16 4h8v8h-8zM4 16h8v8H4zM18 18h4v4',
};
---

<section class="sec hairtop" id="who-is-it-for" aria-labelledby="audiences-title">
  <div class="container">
    <SectionHeader kicker={t.kicker} title={t.title} id="audiences-title" />

    <div class="aud__grid">
      {t.groups.map((g) => (
        <article class="panel aud__card reveal">
          <span class="aud__icon" aria-hidden="true">
            <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={icons[g.icon] ?? icons.lab}></path>
            </svg>
          </span>
          <div>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="aud__ctaline reveal">
      <a class="btn btn--ghost" href="#waitlist" data-cta-source="audiences">{t.ctaButton}</a>
      <span>{t.ctaNote}</span>
    </div>
  </div>
</section>

<style>
  .aud__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .aud__card {
    padding: 1.75rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .aud__icon {
    color: var(--coral-dark);
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.15rem;
  }

  .aud__card h3 {
    font-family: var(--font-body);
    font-size: 1.19rem;
  }

  .aud__card p {
    font-size: 0.88rem;
    margin-top: 0.5rem;
  }

  .aud__ctaline {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  .aud__ctaline span {
    font-size: 0.94rem;
    color: var(--text-body);
  }

  @media (max-width: 56rem) {
    .aud__grid { grid-template-columns: 1fr; }
  }
</style>
