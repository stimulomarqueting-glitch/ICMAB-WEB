---
import { getContent, type Locale } from '../content';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
const t = content.audiences;
const ctaButton = content.conversion.audiences.button;
---

<section class="section" id="who-is-it-for" aria-labelledby="audiences-title">
  <div class="container">
    <SectionHeader num="06" kicker={t.kicker} title={t.title} intro={t.intro} id="audiences-title" />

    <div class="aud__grid">
      {t.groups.map((g, i) => (
        <article class="aud__item reveal">
          <span class="aud__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        </article>
      ))}
    </div>

    {/* the pull-quote of the paper */}
    <blockquote class="aud__quote reveal">
      <p>{t.quote}</p>
      <a class="btn btn--primary aud__cta" href="#waitlist" data-cta-source="audiences">{ctaButton}</a>
    </blockquote>
  </div>
</section>

<style>
  .aud__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 clamp(2rem, 4vw, 3.5rem);
  }

  .aud__item {
    display: flex;
    gap: 1.3rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
  }

  .aud__num {
    flex: 0 0 2rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-3);
    line-height: 1.9;
  }

  .aud__item h3 {
    font-size: 1.02rem;
    margin-bottom: 0.25rem;
  }

  .aud__item p {
    margin: 0;
    color: var(--text-2);
    font-size: 0.93rem;
  }

  .aud__quote {
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding-left: clamp(1.5rem, 4vw, 2.6rem);
    border-left: 3px solid var(--accent);
    max-width: 56rem;
  }

  .aud__quote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--text);
    text-wrap: pretty;
  }

  .aud__cta {
    margin-top: 1.8rem;
  }

  @media (max-width: 48rem) {
    .aud__grid { grid-template-columns: 1fr; }
  }
</style>
