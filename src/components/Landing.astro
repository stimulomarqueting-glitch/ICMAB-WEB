---
/**
 * Full one-page landing, locale-aware.
 * Section order: hero → problem → technology (with detail accordion + CTA
 * band) → benefits → applications → audiences → waitlist.
 * NOTE: the credibility/team section is intentionally out of this first
 * deliverable; institutional detail lives in the "Validation & IP" accordion.
 */
import type { Locale } from '../content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Problem from './Problem.astro';
import Technology from './Technology.astro';
import Benefits from './Benefits.astro';
import Applications from './Applications.astro';
import Audiences from './Audiences.astro';
import ExploreMore from './ExploreMore.astro';
import Waitlist from './Waitlist.astro';
import Footer from './Footer.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const skipLabel = locale === 'es' ? 'Saltar al contenido' : 'Skip to content';
---

<BaseLayout locale={locale}>
  <a class="skip-link" href="#main">{skipLabel}</a>
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <Problem locale={locale} />
    <Technology locale={locale} />
    <Benefits locale={locale} />
    <Applications locale={locale} />
    <Audiences locale={locale} />
    <ExploreMore locale={locale} />
    <Waitlist locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
