---
/**
 * Full-viewport team showcase (top of /team): one cut-out portrait at a
 * time over the plum studio backdrop, the page headline on the left, the
 * active person's bio on the right, and an avatar picker with a meta line
 * (name · role · affiliation · LinkedIn) along the bottom. Manual
 * selection only — no autoplay, no arrows. Works without JS (first
 * profile shown); the card grid below remains the full listing.
 */
import type { TeamMember } from '../content/types';
import { getContent } from '../content';
import { getLocale } from '../i18n';

interface Props {
  members: TeamMember[];
}

const { members } = Astro.props;
const { teamPage } = getContent(getLocale(Astro.url));
const { links, showcase } = teamPage;

const initialsOf = (name: string) =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('');

/* open on the first profile that has a portrait; the monogram stand-in is
   never the first impression while a photo is still pending */
const defaultIndex = Math.max(0, members.findIndex((m) => m.showcaseImage));
const first = members[defaultIndex];

/* what the client script swaps in — no markup, only text and the link */
const data = members.map((m) => ({
  name: m.name,
  role: m.role,
  affiliation: m.affiliation,
  bio: m.bio ?? showcase.noBio,
  linkedin: m.linkedin ?? '',
}));
---

<section class="show" aria-labelledby="page-title" data-showcase>
  <div class="show__bg" aria-hidden="true"></div>

  <div class="show__stage" aria-hidden="true">
    {members.map((m, i) =>
      m.showcaseImage ? (
        <img
          class="show__person"
          src={m.showcaseImage}
          alt=""
          data-index={i}
          data-active={i === defaultIndex ? '' : undefined}
          decoding="async"
          fetchpriority={i === defaultIndex ? 'high' : 'low'}
        />
      ) : (
        <div class="show__person show__person--mono" data-index={i} data-active={i === defaultIndex ? '' : undefined}>
          <span>{initialsOf(m.name)}</span>
        </div>
      )
    )}
  </div>

  <div class="show__scrim" aria-hidden="true"></div>

  <div class="container show__content">
    <div class="show__top">
      <div>
        <p class="eyebrow show__kicker">{teamPage.kicker}</p>
        <h1 class="show__title" id="page-title">{teamPage.title}</h1>
      </div>
      <p class="show__bio is-in" data-bio aria-live="polite">{first.bio ?? showcase.noBio}</p>
    </div>

    <div class="show__bottom">
      <div class="show__picker" role="group" aria-label={showcase.pickerLabel}>
        {members.map((m, i) => (
          <button
            type="button"
            class="show__avatar"
            data-index={i}
            aria-pressed={i === defaultIndex ? 'true' : 'false'}
            aria-label={`${showcase.show} ${m.name}`}
          >
            <span class="show__dot" aria-hidden="true"></span>
            <span class="show__thumb">
              {m.image ? (
                <img src={m.image} alt="" width="56" height="56" loading="lazy" decoding="async" />
              ) : (
                <span class="show__thumb-mono">{initialsOf(m.name)}</span>
              )}
            </span>
          </button>
        ))}
      </div>

      <div class="show__meta">
        <span class="show__name is-in" data-name>{first.name}</span>
        <span class="show__role" data-role>{first.role}</span>
        <span class="show__aff" data-aff>{first.affiliation}</span>
        <a
          class="show__link"
          data-link
          href={first.linkedin}
          target="_blank"
          rel="noopener"
          hidden={!first.linkedin}
          aria-label={`${first.name} ${links.linkedinOf}`}
        >
          {links.linkedin}
        </a>
      </div>
    </div>
  </div>

  <div class="show__strip" aria-hidden="true"></div>
  <script is:inline type="application/json" data-showcase-data set:html={JSON.stringify(data)} />
</section>

<style>
  .show {
    position: relative;
    display: flex;
    min-height: clamp(36rem, calc(100svh - var(--header-h)), 56rem);
    overflow: hidden;
    background: var(--bg-inverse);
    color: #fff;
    isolation: isolate;
  }

  /* plum studio backdrop with a soft vapour glow behind the sitter */
  .show__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 75% at 52% 62%, rgba(108, 18, 248, 0.42), transparent 72%),
      radial-gradient(40% 45% at 8% 100%, rgba(240, 83, 47, 0.16), transparent 70%),
      linear-gradient(180deg, #2b1946 0%, #231536 55%, #1c1030 100%);
  }

  .show__stage {
    position: absolute;
    inset: 0;
  }

  /* the sitter: anchored to the bottom edge, centred a touch right of middle
     so the headline and the bio flank the head */
  .show__person {
    position: absolute;
    bottom: 0;
    left: 50%;
    height: 94%;
    width: auto;
    max-width: 48%;
    object-fit: contain;
    object-position: bottom center;
    transform: translateX(-46%);
    opacity: 0;
    filter: drop-shadow(0 32px 48px rgba(0, 0, 0, 0.38));
    /* the source photos end in a straight frame edge at the shoulders;
       fading the outer 5% dissolves it into the backdrop */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    transition: opacity 700ms ease-out;
  }

  .show__person[data-active] {
    opacity: 1;
  }

  /* monogram stand-in while a portrait is pending */
  .show__person--mono {
    display: grid;
    place-items: end center;
    padding-bottom: 12%;
    width: 48%;
    max-width: none;
    filter: none;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .show__person--mono span {
    font-family: var(--font-display);
    font-size: clamp(6rem, 18vw, 14rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    background: var(--grad-vapor);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.7;
  }

  /* soft vignette: keeps the type legible without flattening the portrait */
  .show__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.24) 0%, rgba(0, 0, 0, 0.04) 45%, rgba(0, 0, 0, 0.42) 100%);
  }

  .show__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 5vh, 3.5rem) clamp(1.5rem, 3vh, 2rem);
  }

  .show__top {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .show__kicker {
    color: rgba(255, 255, 255, 0.72);
  }

  .show__title {
    max-width: 11ch;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5.2vw, 4.6rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }

  .show__bio {
    max-width: 20rem;
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.84);
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.35);
  }

  .show__bottom {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* avatar picker */
  .show__picker {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: none;
  }

  .show__picker::-webkit-scrollbar {
    display: none;
  }

  .show__avatar {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    border-radius: 999px;
  }

  .show__avatar:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* the dot fades in place above the active avatar */
  .show__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #fff;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .show__avatar[aria-pressed='true'] .show__dot {
    opacity: 1;
  }

  .show__thumb {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    overflow: hidden;
    border-radius: 50%;
    background: var(--bg-page);
    opacity: 0.72;
    transition: opacity 300ms ease, transform 300ms var(--ease);
  }

  .show__avatar:hover .show__thumb,
  .show__avatar[aria-pressed='true'] .show__thumb {
    opacity: 1;
  }

  .show__avatar[aria-pressed='true'] .show__thumb {
    transform: translateY(-2px);
  }

  .show__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .show__thumb-mono {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(140deg, var(--violet-tint), var(--coral-tint));
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--violet-dark);
  }

  /* meta line */
  .show__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    font-size: 0.88rem;
    font-weight: 500;
  }

  .show__name {
    color: #fff;
  }

  .show__role,
  .show__aff {
    display: none;
    color: rgba(255, 255, 255, 0.7);
  }

  .show__aff {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .show__link {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(255, 255, 255, 0.5);
    transition: color var(--dur-fast) var(--ease);
  }

  .show__link:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  /* text swap: 4px settle + fade, re-triggered by toggling .is-in */
  @keyframes show-fade {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .is-in {
    animation: show-fade 500ms ease;
  }

  /* 8px vapour strip on the bottom edge, like the home hero */
  .show__strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8px;
    background: var(--grad-vapor);
    z-index: 2;
  }

  /* ── responsive ─────────────────────────────────────────────────── */
  @media (max-width: 40rem) {
    /* phone: the sitter sits in the lower part, under the stacked copy */
    .show__person {
      height: 56%;
      max-width: 92%;
      transform: translateX(-50%);
    }

    .show__person--mono {
      width: 80%;
      padding-bottom: 22%;
    }

    .show__title {
      max-width: 12ch;
    }
  }

  /* tablet: copy is still stacked on the left, so the sitter can be larger
     and sit a little further right */
  @media (min-width: 40rem) and (max-width: 63.98rem) {
    .show__person {
      height: 66%;
      max-width: 64%;
      transform: translateX(-40%);
    }

    .show__person--mono {
      width: 64%;
    }
  }

  @media (min-width: 40rem) {
    .show__picker {
      gap: 0.75rem;
      overflow: visible;
      padding-bottom: 0;
    }

    .show__thumb {
      width: 3.5rem;
      height: 3.5rem;
    }

    .show__role {
      display: inline;
    }
  }

  @media (min-width: 64rem) {
    .show__top {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 4rem;
    }

    .show__bio {
      padding-top: 0.5rem;
      font-size: 1rem;
    }

    .show__aff {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .show__person,
    .show__dot,
    .show__thumb {
      transition: none;
    }

    .is-in {
      animation: none;
    }
  }
</style>

<script>
  /** Team showcase: click an avatar → swap portrait, bio and meta line. */
  const root = document.querySelector<HTMLElement>('[data-showcase]');

  if (root) {
    const raw = root.querySelector<HTMLScriptElement>('[data-showcase-data]')?.textContent ?? '[]';
    const people: { name: string; role: string; affiliation: string; bio: string; linkedin: string }[] = JSON.parse(raw);

    const persons = [...root.querySelectorAll<HTMLElement>('.show__person')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.show__avatar')];
    const bio = root.querySelector<HTMLElement>('[data-bio]')!;
    const name = root.querySelector<HTMLElement>('[data-name]')!;
    const role = root.querySelector<HTMLElement>('[data-role]')!;
    const aff = root.querySelector<HTMLElement>('[data-aff]')!;
    const link = root.querySelector<HTMLAnchorElement>('[data-link]')!;
    let active = buttons.findIndex((b) => b.getAttribute('aria-pressed') === 'true');
    if (active < 0) active = 0;
    const linkOf = link.getAttribute('aria-label')?.replace(people[active]?.name ?? '', '').trim() ?? '';

    /* restart the fade by toggling the class between frames */
    const refade = (el: HTMLElement) => {
      el.classList.remove('is-in');
      void el.offsetWidth;
      el.classList.add('is-in');
    };

    const select = (index: number) => {
      const person = people[index];
      if (!person || index === active) return;
      active = index;

      persons.forEach((p) => p.toggleAttribute('data-active', Number(p.dataset.index) === index));
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.index) === index)));

      bio.textContent = person.bio;
      refade(bio);
      name.textContent = person.name;
      refade(name);
      role.textContent = person.role;
      aff.textContent = person.affiliation;

      link.hidden = !person.linkedin;
      link.href = person.linkedin || '#';
      link.setAttribute('aria-label', `${person.name} ${linkOf}`);
    };

    buttons.forEach((b) => b.addEventListener('click', () => select(Number(b.dataset.index))));

    /* arrow keys move the selection along the picker */
    root.querySelector('.show__picker')?.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key !== 'ArrowRight' && key !== 'ArrowLeft') return;
      e.preventDefault();
      const next = (active + (key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length;
      select(next);
      buttons[next]?.focus();
    });
  }
</script>
