---
/**
 * Full-viewport team showcase (top of /team): one cut-out portrait at a
 * time over the plum studio backdrop, the page headline on the left, the
 * active person's bio on the right, and an avatar picker with a meta line
 * (name · role · affiliation · LinkedIn) along the bottom.
 *
 * Every profile's bio and meta line is in the HTML; JS only toggles which
 * one is active. Rotates on its own every 5.5s, pauses while hovered or
 * focused, off-screen, or when the tab is hidden, restarts after a manual
 * pick, and never autoplays under prefers-reduced-motion.
 */
import type { TeamMember } from '../content/types';
import { getContent } from '../content';
import { getLocale } from '../i18n';

interface Props {
  members: TeamMember[];
}

const { members } = Astro.props;
const { teamPage } = getContent(getLocale(Astro.url));
const { links, showcase } = teamPage;

const initialsOf = (name: string) =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('');

/* open on the first profile that has a portrait; the monogram stand-in is
   never the first impression while a photo is still pending */
const defaultIndex = Math.max(0, members.findIndex((m) => m.showcaseImage));
const on = (i: number) => (i === defaultIndex ? '' : undefined);
---

<section class="show" aria-labelledby="page-title" data-showcase data-interval="5500">
  <div class="show__bg" aria-hidden="true"></div>

  <div class="show__stage" aria-hidden="true">
    {members.map((m, i) => (
      <figure class:list={['show__person', { 'show__person--mono': !m.showcaseImage }]} data-index={i} data-active={on(i)}>
        {m.showcaseImage ? (
          <img src={m.showcaseImage} alt="" decoding="async" fetchpriority={i === defaultIndex ? 'high' : 'low'} />
        ) : (
          <span>{initialsOf(m.name)}</span>
        )}
      </figure>
    ))}
  </div>

  <div class="show__scrim" aria-hidden="true"></div>

  <div class="container show__content">
    <div class="show__top">
      <div>
        <p class="eyebrow show__kicker">{teamPage.kicker}</p>
        <h1 class="show__title" id="page-title">{teamPage.title}</h1>
      </div>
      <div class="show__bios" aria-live="polite">
        {members.map((m, i) => (
          <p class="show__bio is-in" data-index={i} data-active={on(i)}>{m.bio ?? showcase.noBio}</p>
        ))}
      </div>
    </div>

    <div class="show__bottom">
      <div class="show__picker" role="group" aria-label={showcase.pickerLabel}>
        {members.map((m, i) => (
          <button
            type="button"
            class="show__avatar"
            data-index={i}
            aria-pressed={i === defaultIndex ? 'true' : 'false'}
            aria-label={`${showcase.show} ${m.name}`}
          >
            <span class="show__dot" aria-hidden="true"></span>
            <span class="show__thumb">
              {m.image ? (
                <img src={m.image} alt="" width="56" height="56" loading="lazy" decoding="async" />
              ) : (
                <span class="show__thumb-mono">{initialsOf(m.name)}</span>
              )}
            </span>
          </button>
        ))}
      </div>

      <div class="show__metas">
        {members.map((m, i) => (
          <div class="show__meta" data-index={i} data-active={on(i)}>
            <span class="show__name is-in">{m.name}</span>
            <span class="show__role">{m.role}</span>
            <span class="show__aff">{m.affiliation}</span>
            {m.linkedin ? (
              <a class="show__link" href={m.linkedin} target="_blank" rel="noopener" aria-label={`${m.name} ${links.linkedinOf}`}>
                {links.linkedin}
              </a>
            ) : (
              <span></span>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="show__strip" aria-hidden="true"></div>
</section>

<style>
  .show {
    position: relative;
    display: flex;
    min-height: clamp(36rem, calc(100svh - var(--header-h)), 54rem);
    overflow: hidden;
    background: var(--bg-inverse);
    color: #fff;
    isolation: isolate;
  }

  /* plum studio backdrop: a warm key light behind the sitter's head, a
     cool violet fill, and a faint coral bounce bottom-left */
  .show__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38% 46% at 52% 44%, rgba(206, 66, 98, 0.32), transparent 70%),
      radial-gradient(60% 70% at 55% 70%, rgba(108, 18, 248, 0.38), transparent 72%),
      radial-gradient(36% 40% at 6% 100%, rgba(240, 83, 47, 0.14), transparent 70%),
      linear-gradient(180deg, #2b1946 0%, #231536 55%, #1c1030 100%);
  }

  .show__stage {
    position: absolute;
    inset: 0;
  }

  /* the sitter: smaller than a full-bleed portrait, anchored to the bottom,
     centred a touch right of middle so the headline and the bio flank the
     head. The figure fades at its sides and the image fades towards the
     bottom, so the photo's frame edges dissolve into the backdrop. */
  .show__person {
    position: absolute;
    bottom: 0;
    left: 50%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 74%;
    width: 44%; /* explicit: an auto width would be capped by `left` */
    margin: 0;
    transform: translateX(-46%);
    opacity: 0;
    transition: opacity 900ms ease-in-out;
    /* the box fades towards the bottom, the image fades at its own sides */
    -webkit-mask-image: linear-gradient(180deg, #000 0, #000 78%, rgba(0, 0, 0, 0.55) 92%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0, #000 78%, rgba(0, 0, 0, 0.55) 92%, transparent 100%);
  }

  .show__person img {
    display: block;
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    filter: saturate(0.92) contrast(0.97) drop-shadow(0 24px 40px rgba(0, 0, 0, 0.35));
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
  }

  .show__person[data-active] {
    opacity: 1;
  }

  /* monogram stand-in while a portrait is pending */
  .show__person--mono {
    padding-bottom: 14%;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .show__person--mono span {
    font-family: var(--font-display);
    font-size: clamp(5rem, 14vw, 11rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    background: var(--grad-vapor);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.65;
  }

  .show__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.22) 0%, rgba(0, 0, 0, 0.03) 45%, rgba(0, 0, 0, 0.42) 100%);
  }

  .show__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 5vh, 3.5rem) clamp(1.5rem, 3vh, 2rem);
  }

  .show__top {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .show__kicker {
    color: rgba(255, 255, 255, 0.72);
  }

  .show__title {
    max-width: 11ch;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5.2vw, 4.6rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }

  /* only the active bio / meta line is in the flow */
  .show__bio,
  .show__meta {
    display: none;
  }

  .show__bio[data-active] {
    display: block;
  }

  .show__meta[data-active] {
    display: flex;
  }

  .show__bio {
    max-width: 20rem;
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.84);
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.35);
  }

  .show__bottom {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .show__picker {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: none;
  }

  .show__picker::-webkit-scrollbar {
    display: none;
  }

  .show__avatar {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    border-radius: 999px;
  }

  .show__avatar:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .show__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #fff;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .show__avatar[aria-pressed='true'] .show__dot {
    opacity: 1;
  }

  .show__thumb {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    overflow: hidden;
    border-radius: 50%;
    background: var(--bg-page);
    opacity: 0.72;
    transition: opacity 300ms ease, transform 300ms var(--ease);
  }

  .show__avatar:hover .show__thumb,
  .show__avatar[aria-pressed='true'] .show__thumb {
    opacity: 1;
  }

  .show__avatar[aria-pressed='true'] .show__thumb {
    transform: translateY(-2px);
  }

  .show__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .show__thumb-mono {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(140deg, var(--violet-tint), var(--coral-tint));
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--violet-dark);
  }

  .show__metas {
    padding-top: 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }

  .show__meta {
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.88rem;
    font-weight: 500;
  }

  .show__name {
    color: #fff;
  }

  .show__role,
  .show__aff {
    display: none;
    color: rgba(255, 255, 255, 0.7);
  }

  .show__aff {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .show__link {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(255, 255, 255, 0.5);
    transition: color var(--dur-fast) var(--ease);
  }

  .show__link:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  @keyframes show-fade {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .is-in {
    animation: show-fade 500ms ease;
  }

  .show__strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8px;
    background: var(--grad-vapor);
    z-index: 2;
  }

  /* ── responsive ─────────────────────────────────────────────────── */
  @media (max-width: 40rem) {
    .show__top {
      text-align: center;
    }

    .show__title,
    .show__bio {
      margin-inline: auto;
    }

    .show__picker {
      justify-content: center;
    }

    .show__meta {
      justify-content: center;
      text-align: center;
      gap: 0.5rem 1rem;
    }

    .show__person {
      height: 50%;
      width: 84%;
      transform: translateX(-50%);
    }

    .show__person--mono {
      padding-bottom: 22%;
    }

    .show__title {
      max-width: 12ch;
    }
  }

  @media (min-width: 40rem) and (max-width: 63.98rem) {
    .show__person {
      height: 58%;
      width: 60%;
      transform: translateX(-40%);
    }
  }

  @media (min-width: 40rem) {
    .show__picker {
      gap: 0.75rem;
      overflow: visible;
      padding-bottom: 0;
    }

    .show__thumb {
      width: 3.5rem;
      height: 3.5rem;
    }

    .show__role {
      display: inline;
    }
  }

  @media (min-width: 64rem) {
    .show__top {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 4rem;
    }

    .show__bio {
      padding-top: 0.5rem;
      font-size: 1rem;
    }

    .show__aff {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .show__person,
    .show__dot,
    .show__thumb {
      transition: none;
    }

    .is-in {
      animation: none;
    }
  }
</style>

<script>
  /**
   * Team showcase: avatar click → swap portrait, bio and meta line.
   * Auto-rotates on a timer; see the header comment for the pause rules.
   */
  const root = document.querySelector<HTMLElement>('[data-showcase]');

  if (root) {
    const persons = [...root.querySelectorAll<HTMLElement>('.show__person')];
    const bios = [...root.querySelectorAll<HTMLElement>('.show__bio')];
    const metas = [...root.querySelectorAll<HTMLElement>('.show__meta')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.show__avatar')];
    const count = buttons.length;
    const interval = Number(root.dataset.interval) || 5500;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let active = Math.max(0, buttons.findIndex((b) => b.getAttribute('aria-pressed') === 'true'));

    const byIndex = (list: HTMLElement[], i: number) => list.find((el) => Number(el.dataset.index) === i);

    /* restart the settle animation by toggling the class between frames */
    const refade = (el?: HTMLElement | null) => {
      if (!el) return;
      el.classList.remove('is-in');
      void el.offsetWidth;
      el.classList.add('is-in');
    };

    const select = (index: number) => {
      if (index === active || index < 0 || index >= count) return;
      active = index;
      persons.forEach((p) => p.toggleAttribute('data-active', Number(p.dataset.index) === index));
      bios.forEach((b) => b.toggleAttribute('data-active', Number(b.dataset.index) === index));
      metas.forEach((m) => m.toggleAttribute('data-active', Number(m.dataset.index) === index));
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.index) === index)));
      refade(byIndex(bios, index));
      refade(byIndex(metas, index)?.querySelector<HTMLElement>('.show__name'));
    };

    /* ── autoplay ───────────────────────────────────────────────────── */
    let timer: number | undefined;
    let paused = false;
    let visible = true;

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      if (reduceMotion || paused || !visible || document.hidden || count < 2) return;
      timer = window.setInterval(() => select((active + 1) % count), interval);
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        select(Number(b.dataset.index));
        start(); // a manual pick restarts the clock from that person
      })
    );

    root.querySelector('.show__picker')?.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key !== 'ArrowRight' && key !== 'ArrowLeft') return;
      e.preventDefault();
      const next = (active + (key === 'ArrowRight' ? 1 : -1) + count) % count;
      select(next);
      buttons[next]?.focus();
      start();
    });

    const pause = () => { paused = true; stop(); };
    const resume = () => { paused = false; start(); };
    root.addEventListener('pointerenter', pause);
    root.addEventListener('pointerleave', resume);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', (e) => {
      if (!root.contains((e as FocusEvent).relatedTarget as Node | null)) resume();
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          visible ? start() : stop();
        },
        { threshold: 0.35 }
      ).observe(root);
    } else {
      start();
    }
  }
</script>
