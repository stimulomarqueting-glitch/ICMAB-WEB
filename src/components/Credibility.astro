---
import { getContent, type Locale } from '../content';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).credibility;
---

<section class="section" id="credibility" aria-labelledby="credibility-title">
  <div class="container">
    <SectionHeader num="07" kicker={t.kicker} title={t.title} intro={t.intro} id="credibility-title" />

    <ul class="cred__facts" role="list">
      {t.facts.map((fact, i) => (
        <li class="cred__fact reveal">
          <span class="cred__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{fact.title}</h3>
          <p>{fact.text}</p>
        </li>
      ))}
    </ul>

    <div class="cred__logos reveal">
      <h3 class="mono-label">{t.logosTitle}</h3>
      <ul role="list">
        {/* PLACEHOLDER: replace text blocks with official ICMAB / CSIC / FGCSIC
            logos once institutional approval and files are available. */}
        {t.logoPlaceholders.map((logo) => (
          <li class="cred__logo" aria-label={`${logo} (logo placeholder)`}>{logo}</li>
        ))}
      </ul>
      <p class="cred__note">{t.phaseNote}</p>
    </div>
  </div>
</section>

<style>
  .cred__facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0 clamp(1.6rem, 3vw, 2.6rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cred__fact {
    border-top: 1px solid var(--line-strong);
    padding-top: 1.3rem;
    position: relative;
  }

  .cred__fact::before {
    content: '';
    position: absolute;
    top: -2.5px;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-2);
  }

  .cred__num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-3);
    margin-bottom: 0.9rem;
  }

  .cred__fact h3 {
    font-size: 1.02rem;
    margin-bottom: 0.4rem;
  }

  .cred__fact p {
    color: var(--text-2);
    font-size: 0.92rem;
    margin: 0;
  }

  .cred__logos {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
    padding-top: 2.2rem;
  }

  .cred__logos h3 {
    margin-bottom: 1.2rem;
  }

  .cred__logos ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cred__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 9rem;
    padding: 1rem 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--bg-panel);
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--text-2);
  }

  .cred__note {
    margin: 1rem 0 0;
    font-size: 0.8rem;
    color: var(--text-3);
    max-width: 40rem;
  }

  @media (max-width: 56rem) {
    .cred__facts { grid-template-columns: repeat(2, 1fr); }
    .cred__fact { margin-bottom: 1.6rem; }
  }

  @media (max-width: 36rem) {
    .cred__facts { grid-template-columns: 1fr; }
  }
</style>
