---
import { getContent, type Locale } from '../content';
import ParamChip from './ParamChip.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).credibility;
---

<section class="sec hairtop" id="credibility" aria-labelledby="credibility-title">
  <div class="container cred">
    {/* PLACEHOLDER photography from the design source */}
    <img
      class="cred__photo reveal"
      src="/img/icmab-researcher.jpg"
      alt={t.photoAlt}
      width="1000"
      height="667"
      loading="lazy"
    />
    <div>
      <SectionHeader kicker={t.kicker} title={t.title} lead={t.lead} id="credibility-title" />
      <div class="chips cred__chips reveal">
        {t.chips.map((c) => (
          <ParamChip {...c} />
        ))}
      </div>
      <div class="panel cred__heritage reveal">
        <p class="eyebrow">{t.heritage.title}</p>
        <p class="cred__heritage-body">{t.heritage.body}</p>
        <ul class="cred__logos" role="list">
          {/* PLACEHOLDER: swap for official logos once approved */}
          {t.heritage.logos.map((logo) => (
            <li aria-label={`${logo} (logo placeholder)`}>{logo}</li>
          ))}
        </ul>
        <p class="cred__note">{t.heritage.note}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cred {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 4rem;
    align-items: center;
  }

  .cred__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .cred__chips {
    margin-top: 1.5rem;
  }

  .cred__heritage {
    margin-top: 2rem;
    padding: 1.5rem 1.75rem;
    border-left: 3px solid var(--lavender);
  }

  .cred__heritage-body {
    font-size: 0.94rem;
    margin-top: 0.7rem;
    max-width: 52ch;
  }

  .cred__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    margin: 1.15rem 0 0;
    padding: 0;
  }

  .cred__logos li {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.15rem;
    border: 1px dashed var(--silica);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.81rem;
    letter-spacing: 0.16em;
    color: var(--text-body);
  }

  .cred__note {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.7rem;
  }

  @media (max-width: 56rem) {
    .cred {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
