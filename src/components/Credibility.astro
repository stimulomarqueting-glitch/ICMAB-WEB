---
import { getContent, type Locale } from '../content';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).credibility;
---

<section class="section" id="credibility" aria-labelledby="credibility-title">
  <div class="container">
    <SectionHeader kicker={t.kicker} title={t.title} intro={t.intro} id="credibility-title" />

    <div class="grid grid--4">
      {t.facts.map((fact) => (
        <article class="card reveal">
          <span class="card__icon"><Icon name={fact.icon ?? 'lab'} /></span>
          <h3>{fact.title}</h3>
          <p>{fact.text}</p>
        </article>
      ))}
    </div>

    <div class="cred__logos reveal">
      <h3>{t.logosTitle}</h3>
      <ul role="list">
        {/* PLACEHOLDER: replace text blocks with official ICMAB / CSIC / FGCSIC
            logos once institutional approval and files are available. */}
        {t.logoPlaceholders.map((logo) => (
          <li class="cred__logo" aria-label={`${logo} (logo placeholder)`}>{logo}</li>
        ))}
      </ul>
      <p class="cred__note">{t.phaseNote}</p>
    </div>
  </div>
</section>

<style>
  .cred__logos {
    margin-top: 3rem;
    border-top: 1px solid var(--line);
    padding-top: 2.2rem;
  }

  .cred__logos h3 {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 1.2rem;
  }

  .cred__logos ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cred__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 9rem;
    padding: 1rem 1.6rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-s);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--text-3);
    background: rgba(21, 30, 40, 0.4);
  }

  .cred__note {
    margin: 1rem 0 0;
    font-size: 0.78rem;
    color: var(--text-3);
    max-width: 40rem;
  }
</style>
