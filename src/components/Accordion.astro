---
/**
 * Accessible accordion for expanded/technical detail.
 * The page must be understandable without opening any item — these hold
 * the "go deeper" layer only.
 *
 * A11y: <button aria-expanded aria-controls> toggles a labelled region;
 * fully keyboard-operable (native button), motion-safe.
 */
interface Props {
  /** optional mono eyebrow above the list (omit when the section already has a header) */
  title?: string;
  items: { q: string; a: string }[];
  /** unique prefix so multiple accordions could coexist */
  idPrefix?: string;
}

const { title, items, idPrefix = 'acc' } = Astro.props;
---

<div class="acc reveal">
  {title && <p class="eyebrow">{title}</p>}
  <ul class="acc__list" role="list">
    {items.map((item, i) => (
      <li class="acc__item">
        <h3 class="acc__heading">
          <button
            type="button"
            class="acc__trigger"
            id={`${idPrefix}-t-${i}`}
            aria-expanded="false"
            aria-controls={`${idPrefix}-p-${i}`}
          >
            {item.q}
            <span class="acc__icon" aria-hidden="true"></span>
          </button>
        </h3>
        <div
          class="acc__panel"
          id={`${idPrefix}-p-${i}`}
          role="region"
          aria-labelledby={`${idPrefix}-t-${i}`}
          hidden
        >
          <div class="acc__inner">
            <p>{item.a}</p>
          </div>
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  .acc {
    margin-top: 2.25rem;
  }

  .acc__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--border-subtle);
  }

  .acc__item {
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
  }

  /* the open item grows a vapour hairline over its top edge */
  .acc__item::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--grad-vapor-line);
    transition: width 600ms var(--ease-out);
  }

  .acc__item[data-open]::before {
    width: 100%;
  }

  .acc__heading {
    margin: 0;
  }

  .acc__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    padding: 1.1rem 0.25rem;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease);
  }

  .acc__trigger:hover {
    color: var(--coral-dark);
  }

  .acc__trigger[aria-expanded='true'] {
    color: var(--violet-dark);
  }

  /* plus → minus, drawn with borders (no icon font) */
  .acc__icon {
    position: relative;
    flex: none;
    width: 0.85rem;
    height: 0.85rem;
  }

  .acc__icon::before,
  .acc__icon::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--coral);
    transition: transform var(--dur-base) var(--ease), background-color var(--dur-base) var(--ease);
  }

  .acc__trigger[aria-expanded='true'] .acc__icon::before,
  .acc__trigger[aria-expanded='true'] .acc__icon::after {
    background: var(--violet);
  }

  .acc__icon::before {
    width: 100%;
    height: 2px;
  }

  .acc__icon::after {
    width: 2px;
    height: 100%;
  }

  .acc__trigger[aria-expanded='true'] .acc__icon::after {
    transform: scaleY(0);
  }

  /* the panel opens by growing its grid row, so the height animates */
  .acc__panel {
    display: grid;
    grid-template-rows: 0fr;
    padding: 0 0.25rem;
    transition: grid-template-rows 360ms var(--ease-out), padding 360ms var(--ease-out);
  }

  .acc__panel[hidden] {
    display: none;
  }

  .acc__item[data-open] .acc__panel {
    grid-template-rows: 1fr;
    padding-bottom: 1.35rem;
  }

  .acc__inner {
    overflow: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 300ms var(--ease-out) 80ms, transform 300ms var(--ease-out) 80ms;
  }

  .acc__item[data-open] .acc__inner {
    opacity: 1;
    transform: none;
  }

  .acc__panel p {
    max-width: 70ch;
    font-size: 0.94rem;
    line-height: 1.65;
  }

  @media (prefers-reduced-motion: reduce) {
    .acc__panel,
    .acc__inner,
    .acc__item::before {
      transition: none;
    }
  }
</style>

<script>
  /* open: unhide, then grow on the next frame; close: shrink, then hide */
  document.querySelectorAll<HTMLButtonElement>('.acc__trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      const item = btn.closest<HTMLElement>('.acc__item');
      btn.setAttribute('aria-expanded', String(!expanded));
      if (!panel || !item) return;
      if (expanded) {
        item.removeAttribute('data-open');
        const hide = () => { panel.hidden = true; panel.removeEventListener('transitionend', hide); };
        panel.addEventListener('transitionend', hide);
        window.setTimeout(hide, 420); // safety net if no transition fires
      } else {
        panel.hidden = false;
        requestAnimationFrame(() => requestAnimationFrame(() => item.setAttribute('data-open', '')));
      }
    });
  });
</script>
