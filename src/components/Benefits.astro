---
import { getContent, type Locale } from '../content';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).benefits;
---

<section class="sec hairtop" id="benefits" aria-labelledby="benefits-title">
  <div class="container">
    <SectionHeader kicker={t.kicker} title={t.title} id="benefits-title" />

    <div class="bene__split">
      <div class="reveal">
        <p class="bene__colhead">{t.specsHead}</p>
        <ul class="bene__specs" role="list">
          {t.specs.map((s) => (
            <li>
              <span class="bene__sym">{s.sym}</span>
              <span>{s.text}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal">
        <p class="bene__colhead">{t.outcomesHead}</p>
        {t.outcomes.map((o) => (
          <div class="bene__outcome">
            <h3>{o.title}</h3>
            <p>{o.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .bene__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-top: 3rem;
  }

  .bene__colhead {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.15rem;
  }

  .bene__specs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bene__specs li {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.94rem;
  }

  .bene__sym {
    font-family: var(--font-mono);
    font-size: 0.81rem;
    font-weight: 600;
    color: var(--violet-dark);
    min-width: 4rem;
  }

  .bene__outcome {
    padding: 1.35rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .bene__outcome h3 {
    font-size: 1.19rem;
  }

  .bene__outcome p {
    font-size: 0.94rem;
    margin-top: 0.5rem;
    max-width: 48ch;
  }

  @media (max-width: 56rem) {
    .bene__split {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
