---
import { getContent, type Locale } from '../content';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).benefits;
---

<section class="sec hairtop" id="benefits" aria-labelledby="benefits-title">
  <div class="container">
    <SectionHeader kicker={t.kicker} title={t.title} id="benefits-title" />

    <div class="bene__grid">
      {t.outcomes.map((o) => (
        <div class="bene__outcome reveal">
          <h3>{o.title}</h3>
          <p>{o.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bene__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 4rem;
    margin-top: 2.5rem;
  }

  .bene__outcome {
    padding: 1.35rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .bene__outcome h3 {
    font-size: 1.19rem;
  }

  .bene__outcome p {
    font-size: 0.94rem;
    margin-top: 0.5rem;
    max-width: 48ch;
  }

  @media (max-width: 56rem) {
    .bene__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
