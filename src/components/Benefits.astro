---
/**
 * Outcome band — the dark beat of a page (plum-violet, v3).
 * Props-driven so home and /product can show different depths of copy.
 */
import SectionHeader from './SectionHeader.astro';

interface Props {
  kicker: string;
  title: string;
  outcomes: readonly { title: string; text: string }[];
  id?: string;
}

const { kicker, title, outcomes, id = 'benefits-title' } = Astro.props;
---

<section class="sec bene--dark" id="benefits" aria-labelledby={id}>
  <div class="container">
    <SectionHeader kicker={kicker} title={title} id={id} />

    <div class="bene__grid">
      {outcomes.map((o) => (
        <div class="bene__outcome reveal">
          <h3>{o.title}</h3>
          <p>{o.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bene--dark {
    position: relative;
    background: var(--bg-inverse);
  }

  /* deposition dots resting on the section's top edge */
  .bene--dark::before {
    content: '';
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    margin-top: calc(-1 * clamp(2.75rem, 5.5vw, 4.25rem));
    height: 3px;
    background-image: radial-gradient(circle, var(--lavender) 1.2px, transparent 1.4px);
    background-size: 12px 3px;
    background-repeat: repeat-x;
    opacity: 0.6;
  }

  .bene--dark :global(.eyebrow) {
    color: var(--lavender);
  }

  .bene--dark :global(.h2) {
    color: var(--text-on-dark);
  }

  .bene__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 4rem;
    margin-top: 2rem;
  }

  .bene__outcome {
    padding: 1.25rem 0;
    border-top: 1px solid rgba(248, 246, 243, 0.16);
  }

  .bene__outcome h3 {
    font-size: 1.19rem;
    color: var(--text-on-dark);
  }

  .bene__outcome p {
    font-size: 0.94rem;
    margin-top: 0.5rem;
    max-width: 48ch;
    color: var(--text-on-dark-2);
  }

  @media (max-width: 56rem) {
    .bene__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
