---
import { brand } from '../config/brand';
import { getContent, type Locale } from '../content';
import BrandMark from './BrandMark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).footer;
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href="#top">
          <BrandMark />
          {brand.projectName}
        </a>
        <p class="footer__desc">{t.description}</p>
        <a class="btn btn--sm footer__cta" href="#waitlist" data-cta-source="footer">{t.cta}</a>
      </div>

      <div class="footer__nav">
        {t.columns.map((col) => (
          <div>
            <span class="eyebrow">{col.title}</span>
            {col.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="footer__bottom">
      <span>{t.copyright}</span>
      <span class="mono">{t.bottomMono}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--silica);
    padding: 4rem 0 2.5rem;
    margin-top: 2rem;
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    gap: 2.5rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .footer__brand {
    max-width: 21rem;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
  }

  .footer__logo:hover {
    color: var(--ink);
  }

  .footer__desc {
    font-size: 0.88rem;
    margin-top: 0.9rem;
  }

  .footer__cta {
    margin-top: 1.25rem;
  }

  .footer__nav {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .footer__nav div {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.88rem;
    min-width: 8rem;
  }

  .footer__nav a {
    color: var(--text-body);
  }

  .footer__nav a:hover {
    color: var(--ink);
  }

  .footer__nav a[aria-current='true'] {
    color: var(--coral-dark);
    font-weight: 600;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.81rem;
    color: var(--text-muted);
  }

  .footer__bottom .mono {
    font-size: 0.75rem;
  }
</style>
