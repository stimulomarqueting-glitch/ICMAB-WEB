---
/**
 * Site footer (v3, warm coral tint): brand block + three link columns +
 * legal line. Content comes from src/content/site.ts.
 */
import { brand } from '../config/brand';
import { site } from '../content/site';
import BrandMark from './BrandMark.astro';

const t = site.footer;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href="/">
          <BrandMark />
          <span class="wordmark">{brand.projectName}</span>
        </a>
        <p class="footer__desc">{t.description}</p>
        <a class="btn btn--sm footer__cta" href={t.ctaHref} data-cta-source="footer">{t.cta}</a>
      </div>

      <nav class="footer__nav" aria-label="Footer">
        {t.columns.map((col) => (
          <div>
            <span class="eyebrow">{col.title}</span>
            {col.links.map((link) => (
              <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
                {link.label}
              </a>
            ))}
          </div>
        ))}
      </nav>
    </div>

    <div class="footer__bottom">
      <span>{t.copyright}</span>
      <span class="mono">{t.bottomMono}</span>
    </div>
  </div>
</footer>

<style>
  /* v3: warm coral-tinted footer */
  .footer {
    background: var(--bg-mist);
    border-top: 1px solid var(--border-coral-soft);
    padding: 4rem 0 2.5rem;
    margin-top: 2rem;
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    gap: 2.5rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .footer__brand {
    max-width: 21rem;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1rem;
    color: var(--ink);
  }

  .footer__logo:hover {
    color: var(--ink);
  }

  .footer__desc {
    font-size: 0.88rem;
    margin-top: 0.9rem;
  }

  .footer__cta {
    margin-top: 1.25rem;
  }

  .footer__nav {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .footer__nav div {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.88rem;
    min-width: 8rem;
  }

  .footer__nav a {
    color: var(--text-body);
  }

  .footer__nav a:hover {
    color: var(--ink);
  }

  .footer__nav a[aria-current='page'] {
    color: var(--coral-dark);
    font-weight: 600;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-coral-soft);
    font-size: 0.81rem;
    color: var(--text-muted);
  }

  .footer__bottom .mono {
    font-size: 0.75rem;
  }
</style>
