---
import { brand } from '../config/brand';
import { getContent, type Locale } from '../content';
import DepositionVisual from './DepositionVisual.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    {/* datasheet meta bar: name · claim · origin, under a strong rule */}
    <p class="hero__meta">
      <span class="hero__meta-name">{brand.projectName}</span>
      <span class="hero__meta-claim">{t.hero.eyebrow}</span>
      <span class="hero__meta-fill" aria-hidden="true"></span>
      <span class="hero__meta-origin">{t.hero.microcopy}</span>
    </p>

    <h1 class="hero__title" id="hero-title">
      {t.hero.headline}
      <span class="hero__title-accent">{t.hero.headlineAccent}</span>
    </h1>

    <div class="hero__row">
      <div class="hero__lead">
        <p class="hero__sub">{t.hero.subheadline}</p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href="#waitlist" data-cta-source="hero">{t.hero.ctaPrimary}</a>
          <a class="btn btn--ghost" href="#technology">{t.hero.ctaSecondary}</a>
        </div>

        <dl class="hero__stats">
          {t.hero.stats.map((s) => (
            <div class="hero__stat">
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="hero__visual">
        <DepositionVisual alt={t.hero.visualAlt} caption={t.hero.visualCaption} />
      </div>
    </div>
  </div>
  <div class="hero__baseline surface-line surface-line--dots" aria-hidden="true"></div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) 0;
    background: var(--bg);
  }

  .hero__meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
    border-top: 2px solid var(--text);
    padding-top: 0.8rem;
    margin: 0 0 clamp(2rem, 5vw, 3.5rem);
  }

  .hero__meta-name {
    font-weight: 600;
    color: var(--text);
  }

  .hero__meta-claim {
    color: var(--accent);
    font-weight: 600;
  }

  .hero__meta-fill {
    flex: 1;
    min-width: 2rem;
  }

  .hero__meta-origin {
    text-align: right;
  }

  .hero__title {
    font-size: clamp(2.7rem, 7.4vw, 5.9rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 20ch;
    margin: 0 0 clamp(2rem, 4.5vw, 3.2rem);
  }

  /* the accent phrase carries the deposited layer: a thick teal underline */
  .hero__title-accent {
    display: inline;
    background: linear-gradient(var(--accent), var(--accent)) no-repeat left 96% / 100% 0.09em;
    padding-bottom: 0.06em;
  }

  .hero__row {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .hero__sub {
    font-size: 1.18rem;
    line-height: 1.65;
    color: var(--text-2);
    max-width: 33rem;
    margin-bottom: 2rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* readout table: three columns divided by hairlines, mono values */
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    border-top: 1px solid var(--line-strong);
    padding-top: 1.3rem;
  }

  .hero__stat + .hero__stat {
    border-left: 1px solid var(--line);
    padding-left: 1.4rem;
  }

  .hero__stat dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--accent-2);
  }

  .hero__stat dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    order: 2;
    margin-top: 0.3rem;
  }

  .hero__baseline {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  @media (max-width: 56rem) {
    .hero__row { grid-template-columns: 1fr; }
    .hero__visual { max-width: 27rem; }
  }

  @media (max-width: 36rem) {
    .hero__stats {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .hero__stat + .hero__stat {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--line);
      padding-top: 0.9rem;
    }

    .hero__meta-origin { text-align: left; }
  }
</style>
