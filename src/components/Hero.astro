---
import { brand } from '../config/brand';
import { getContent, type Locale } from '../content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const claim = locale === 'es' ? brand.claimEs : brand.claim;
---

{/* HeroBlock (design system): dark process panel with subtle vapour glow
    and the material→vapour→layer gradient strip on its bottom edge.
    The gradient appears because the hero IS a process-narrative moment. */}
<section class="hero-band" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero">
      <div>
        <p class="eyebrow hero__eyebrow">{t.hero.eyebrow}</p>
        <h1 class="hero__title" id="hero-title">{t.hero.headline}</h1>
        <p class="hero__descriptor">{t.hero.descriptor}</p>
        <p class="hero__lead">{t.hero.lead}</p>
        <div class="hero__ctas">
          <a class="btn" href="#waitlist" data-cta-source="hero">{t.hero.ctaPrimary}</a>
          <a class="btn btn--ghost-dark" href="#technology">{t.hero.ctaSecondary}</a>
        </div>
        <p class="hero__claim">{claim}</p>
      </div>

      <img
        class="hero__photo"
        src="/img/product-table.jpg"
        alt={t.hero.photoAlt}
        width="1100"
        height="619"
        fetchpriority="high"
      />
    </div>
  </div>
  <div class="hero-band__strip" aria-hidden="true"></div>
</section>

<style>
  /* full-bleed dark process band, edge to edge */
  .hero-band {
    position: relative;
    overflow: hidden;
    background: var(--bg-inverse);
    color: var(--text-on-dark);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* vapour glow — violet rising from the top-right corner */
  .hero-band::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--glow-vapor);
    pointer-events: none;
  }

  /* the process strip: solid material → vapour → deposited layer */
  .hero-band__strip {
    position: relative;
    height: 6px;
    background: var(--grad-vapor);
    margin-top: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .hero__eyebrow {
    color: var(--text-on-dark-2);
  }

  .hero__title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.02;
    margin-top: 0.9rem;
    color: var(--text-on-dark);
  }

  .hero__descriptor {
    font-family: var(--font-mono);
    font-size: 0.94rem;
    font-weight: 500;
    color: var(--text-on-dark);
    margin-top: 1.25rem;
    letter-spacing: 0.01em;
  }

  .hero__lead {
    font-size: 1.125rem;
    line-height: 1.55;
    max-width: 34rem;
    margin-top: 1rem;
    color: var(--text-on-dark-2);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* the claim, set in mono caps and the deposited-layer lavender */
  .hero__claim {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lavender);
    margin-top: 1.6rem;
  }

  .hero__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 62% center;
    border: 1px solid rgba(248, 246, 243, 0.18);
    border-radius: var(--radius-md);
  }

  @media (max-width: 56rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .hero__photo {
      aspect-ratio: 16 / 10;
      object-position: center 40%;
    }

    .hero__eyebrow {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 40rem) {
    .hero__ctas .btn {
      width: 100%;
    }
  }
</style>
