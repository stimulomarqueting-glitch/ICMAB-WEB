---
import { brand } from '../config/brand';
import { home } from '../content/home';

const t = home.hero;
const claim = brand.claim;

/* v3 lockup: the last word of the claim is always emphasised ("…for ALL.") */
const claimMatch = claim.match(/^(.*\s)(\S+?)(\.?)$/);
const claimLead = claimMatch ? claimMatch[1] : '';
const claimEmph = claimMatch ? claimMatch[2] : claim;
const claimEnd = claimMatch ? claimMatch[3] : '';
---

{/* HeroBlock (design system v3): full-bleed photo under the 5-phase
    sublimation gradient, white text, glass secondary CTA, 8px process
    strip on the bottom edge. */}
<section class="hero-band" aria-labelledby="hero-title">
  <img
    class="hero-band__photo"
    src="/img/product-table.jpg"
    alt={t.photoAlt}
    width="1100"
    height="619"
    fetchpriority="high"
  />
  <div class="hero-band__tint" aria-hidden="true"></div>

  <div class="container hero">
    <p class="hero__claim">{claimLead}<b>{claimEmph}</b>{claimEnd}</p>
    <h1 class="hero__title" id="hero-title">{t.headline}</h1>
    <p class="hero__descriptor">{t.descriptor}</p>
    <p class="hero__lead">{t.lead}</p>
    <div class="hero__ctas">
      <a class="btn" href="/contact" data-cta-source="hero">{t.ctaPrimary}</a>
      <a class="btn btn--glass" href="/product" data-cta-source="hero-product">{t.ctaSecondary}</a>
    </div>
    <p class="eyebrow hero__eyebrow">{t.eyebrow}</p>
  </div>

  <div class="hero-band__strip" aria-hidden="true"></div>
</section>

<style>
  /* full-bleed process band: photo + sublimation duotone, edge to edge */
  .hero-band {
    position: relative;
    overflow: hidden;
    background: var(--bg-inverse);
    color: var(--text-on-dark);
    padding-top: clamp(3.25rem, 6vw, 5.5rem);
  }

  .hero-band__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
  }

  /* the 5-phase gradient reads the photo: material (coral) → vapour (violet) */
  .hero-band__tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(240, 83, 47, 0.9) 0%,
      rgba(206, 66, 98, 0.82) 48%,
      rgba(108, 18, 248, 0.78) 100%
    );
  }

  /* the process strip: solid material → vapour → deposited layer */
  .hero-band__strip {
    position: relative;
    height: 8px;
    background: var(--grad-vapor);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .hero {
    position: relative;
    max-width: var(--container);
  }

  /* the claim opens the hero — mono caps, emphasised last word */
  .hero__claim {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    margin: 0;
  }

  .hero__claim b {
    color: #fff;
    font-weight: 600;
  }

  .hero__title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.02;
    margin-top: 1rem;
    max-width: 15ch;
    color: #fff;
  }

  .hero__descriptor {
    font-family: var(--font-mono);
    font-size: 0.94rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.95);
    margin-top: 1.25rem;
    letter-spacing: 0.01em;
  }

  .hero__lead {
    font-size: 1.125rem;
    line-height: 1.55;
    max-width: 35rem;
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* institutional line closes the hero, small and quiet */
  .hero__eyebrow {
    color: rgba(255, 255, 255, 0.75);
    margin-top: 2.25rem;
  }

  @media (max-width: 56rem) {
    .hero-band__photo {
      object-position: 70% center;
    }

    .hero__eyebrow {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 40rem) {
    .hero__ctas .btn {
      width: 100%;
    }
  }
</style>
