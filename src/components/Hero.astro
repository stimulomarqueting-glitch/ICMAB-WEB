---
import { brand } from '../config/brand';
import { getContent, type Locale } from '../content';
import DepositionVisual from './DepositionVisual.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <span class="hero__eyebrow-name">{brand.projectName}</span>
        <span class="hero__eyebrow-sep" aria-hidden="true">·</span>
        {t.hero.eyebrow}
      </p>
      <h1 id="hero-title" class="hero__title">
        {t.hero.headline}
        <span class="hero__title-accent">{t.hero.headlineAccent}</span>
      </h1>
      <p class="hero__sub">{t.hero.subheadline}</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="#waitlist">{t.hero.ctaPrimary}</a>
        <a class="btn btn--ghost" href="#technology">{t.hero.ctaSecondary}</a>
      </div>
      <p class="hero__micro">{t.hero.microcopy}</p>

      <dl class="hero__stats">
        {t.hero.stats.map((s) => (
          <div class="hero__stat">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero__visual">
      <DepositionVisual alt={t.hero.visualAlt} caption={t.hero.visualCaption} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(3rem, 7vw, 5.5rem);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 75% 12%, rgba(47, 217, 195, 0.1), transparent 65%),
      radial-gradient(45% 45% at 10% 85%, rgba(90, 169, 255, 0.07), transparent 60%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-2);
    background: rgba(21, 30, 40, 0.6);
  }

  .hero__eyebrow-name {
    font-weight: 700;
    color: var(--accent);
  }

  .hero__eyebrow-sep { color: var(--text-3); }

  .hero__title {
    font-size: clamp(2.3rem, 5.4vw, 3.9rem);
    margin: 1.2rem 0 0.9rem;
  }

  .hero__title-accent {
    display: block;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__sub {
    color: var(--text-2);
    font-size: 1.12rem;
    max-width: 34rem;
    margin-bottom: 1.8rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero__micro {
    margin-top: 1.1rem;
    font-size: 0.83rem;
    color: var(--text-3);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
    margin: 2.2rem 0 0;
    border-top: 1px solid var(--line);
    padding-top: 1.4rem;
  }

  .hero__stat + .hero__stat {
    border-left: 1px solid var(--line);
    padding-left: 1.4rem;
  }

  .hero__stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text);
  }

  .hero__stat dt {
    font-size: 0.76rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-3);
    order: 2;
  }

  @media (max-width: 56rem) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__visual { max-width: 30rem; }
  }

  @media (max-width: 36rem) {
    .hero__stats {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .hero__stat + .hero__stat {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--line);
      padding-top: 0.9rem;
    }
  }
</style>
