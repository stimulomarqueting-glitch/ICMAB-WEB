---
import { brand } from '../config/brand';
import { getContent, type Locale } from '../content';
import ParamChip from './ParamChip.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const { claim, claimEs } = brand;
---

<section aria-labelledby="hero-title">
  <div class="container hero">
    <div>
      <p class="eyebrow hero__eyebrow">{t.hero.eyebrow}</p>
      <h1 class="hero__title" id="hero-title">{t.hero.headline}</h1>
      <p class="hero__descriptor">{t.hero.descriptor}</p>
      <p class="lead">{t.hero.lead}</p>
      <div class="hero__ctas">
        <a class="btn" href="#waitlist" data-cta-source="hero">{t.hero.ctaPrimary}</a>
        <a class="btn btn--ghost" href="#technology">{t.hero.ctaSecondary}</a>
      </div>
      <p class="hero__claim">
        <span class="hero__claim-line" aria-hidden="true"></span>
        {locale === 'es' ? claimEs : claim}
      </p>
    </div>

    {/* PLACEHOLDER photography from the design source — replace when final
        brand photography is approved (public/img/hero-device.jpg). */}
    <img
      class="hero__photo"
      src="/img/hero-device.jpg"
      alt={t.hero.photoAlt}
      width="1100"
      height="1647"
      fetchpriority="high"
    />
  </div>

  <div class="container hero__specstrip">
    <div class="hero__divider">
      <span class="eyebrow">{t.hero.paramsLabel}</span>
      <span class="surface-line surface-line--dots hero__divider-line" aria-hidden="true"></span>
    </div>
    <div class="chips">
      {t.hero.chips.map((c) => (
        <ParamChip {...c} />
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 3.5rem;
    align-items: center;
    padding-block: clamp(3rem, 6vw, 5.5rem) 4rem;
  }

  .hero__eyebrow {
    color: var(--text-muted);
  }

  .hero__title {
    font-size: clamp(2.5rem, 5.4vw, 4.25rem);
    line-height: 1.02;
    margin-top: 0.9rem;
  }

  .hero__descriptor {
    font-family: var(--font-mono);
    font-size: 0.94rem;
    font-weight: 500;
    color: var(--ink);
    margin-top: 1.25rem;
    letter-spacing: 0.01em;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__claim {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.94rem;
    color: var(--ink);
  }

  /* the gradient IS the sublimation — process moments only */
  .hero__claim-line {
    display: inline-block;
    width: 2.75rem;
    height: 3px;
    background: var(--grad-vapor-line);
    border-radius: 2px;
  }

  .hero__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 30%;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-glass);
  }

  .hero__specstrip {
    padding-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  .hero__divider {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hero__divider-line {
    flex: 1;
  }

  .hero__specstrip .chips {
    margin-top: 1rem;
  }

  @media (max-width: 56rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding-block: 3rem 2.5rem;
    }

    .hero__photo {
      aspect-ratio: 16 / 10;
      object-position: center 40%;
    }

    /* the mono descriptor and CTA reach the first screen sooner on mobile */
    .hero__eyebrow {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 40rem) {
    .hero__ctas .btn {
      width: 100%;
    }
  }
</style>
