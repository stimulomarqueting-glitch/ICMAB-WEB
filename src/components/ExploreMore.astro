---
/**
 * Compact strip linking to /team and /research — keeps the landing light
 * while giving both pages a visible entry point near the end of the page.
 */
import { getContent, type Locale } from '../content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).explore;
---

<section class="sec hairtop explore" aria-label={`${t.teamTitle} · ${t.researchTitle}`}>
  <div class="container explore__grid">
    <div class="panel explore__card reveal">
      <div>
        <h2>{t.teamTitle}</h2>
        <p>{t.teamText}</p>
      </div>
      <a class="btn btn--ghost btn--sm" href="/team">{t.teamCta}</a>
    </div>
    <div class="panel explore__card reveal">
      <div>
        <h2>{t.researchTitle}</h2>
        <p>{t.researchText}</p>
      </div>
      <a class="btn btn--ghost btn--sm" href="/research">{t.researchCta}</a>
    </div>
  </div>
</section>

<style>
  .explore {
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .explore__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .explore__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 1.75rem;
  }

  .explore__card h2 {
    font-size: 1.19rem;
  }

  .explore__card p {
    font-size: 0.88rem;
    margin-top: 0.4rem;
    max-width: 34ch;
  }

  .explore__card .btn {
    flex: none;
  }

  @media (max-width: 56rem) {
    .explore__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .explore__card {
      flex-direction: column;
      align-items: flex-start;
    }

    .explore__card .btn {
      width: 100%;
    }
  }
</style>
