---
/**
 * Home hero, "sublimation field" variant. The visual is the process itself,
 * drawn live on a canvas: particles leave a heated source at the bottom
 * (coral), cool as they rise (magenta → violet) and condense into a thin
 * layer on the substrate above — while the source–substrate distance `d`
 * slowly breathes. The pointer disturbs the vapour. Copy, CTAs and the
 * claim lockup are the same as the photo hero (home.hero).
 *
 * Motion is progressive enhancement: no JS → the plum backdrop and copy;
 * prefers-reduced-motion → one still frame, no marquee, no text rise.
 * The loop pauses off-screen and when the tab is hidden.
 */
import { brand } from '../config/brand';
import { getContent } from '../content';
import { getLocale, localePath } from '../i18n';

const locale = getLocale(Astro.url);
const { home } = getContent(locale);
const t = home.hero;
const lp = (href: string) => localePath(locale, href);

const claim = locale === 'es' ? brand.claimEs : brand.claim;
const claimMatch = claim.match(/^(.*\s)(\S+?)(\.?)$/);
const claimLead = claimMatch ? claimMatch[1] : '';
const claimEmph = claimMatch ? claimMatch[2] : claim;
const claimEnd = claimMatch ? claimMatch[3] : '';

/* the headline rises word by word */
const words = t.headline.split(' ');
const marquee = [...t.field.marquee, ...t.field.marquee];
---

<section class="field" aria-labelledby="hero-title" data-field>
  <div class="field__mesh" aria-hidden="true"></div>
  <img class="field__photo" src="/img/tech-detail.jpg" alt="" width="1000" height="750" decoding="async" aria-hidden="true" />
  <canvas class="field__canvas" aria-hidden="true"></canvas>

  {/* the two lines of the process, labelled; the substrate follows `d` */}
  <div class="field__labels" aria-hidden="true">
    <span class="field__label field__label--substrate" data-substrate-label>{t.field.substrate}</span>
    <span class="field__label field__label--d" data-d-label>{t.field.distance}</span>
    <span class="field__label field__label--source" data-source-label>{t.field.source}</span>
  </div>

  <div class="container field__content">
    <p class="field__claim rise" style="--i: 0">{claimLead}<b>{claimEmph}</b>{claimEnd}</p>
    <h1 class="field__title" id="hero-title">
      {words.map((w, i) => (
        <>
          <span class="field__word"><span class="rise" style={`--i: ${i + 1}`}>{w}</span></span>{' '}
        </>
      ))}
    </h1>
    <p class="field__descriptor rise" style={`--i: ${words.length + 1}`}>{t.descriptor}</p>
    <p class="field__lead rise" style={`--i: ${words.length + 2}`}>{t.lead}</p>
    <div class="field__ctas rise" style={`--i: ${words.length + 3}`}>
      <a class="btn" href={lp('/contact')} data-cta-source="hero">{t.ctaPrimary}</a>
      <a class="btn btn--glass" href={lp('/product')} data-cta-source="hero-product">{t.ctaSecondary}</a>
    </div>
    <p class="eyebrow field__eyebrow rise" style={`--i: ${words.length + 4}`}>{t.eyebrow}</p>
  </div>

  {/* application fields drift along the bottom edge */}
  <div class="field__marquee" aria-hidden="true">
    <ul class="field__track">
      {marquee.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
  <div class="field__strip" aria-hidden="true"></div>
</section>

<style>
  .field {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(38rem, calc(100svh - var(--header-h)), 56rem);
    overflow: hidden;
    background: var(--bg-inverse);
    color: var(--text-on-dark);
    isolation: isolate;
    --px: 0.7; /* pointer position, 0–1, steers the mesh a little */
    --py: 0.4;
  }

  /* slow gradient mesh: heat bottom-left, vacuum top-right */
  .field__mesh {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(40% 40% at calc(20% + var(--px) * 10%) 95%, rgba(240, 83, 47, 0.28), transparent 70%),
      radial-gradient(45% 55% at calc(70% + var(--px) * 8%) calc(20% + var(--py) * 10%), rgba(108, 18, 248, 0.42), transparent 70%),
      radial-gradient(30% 35% at 55% 60%, rgba(206, 66, 98, 0.18), transparent 70%),
      linear-gradient(180deg, #2a1845 0%, #231536 50%, #1a0f2c 100%);
    animation: field-drift 22s ease-in-out infinite alternate;
    transition: background-position 600ms var(--ease);
  }

  @keyframes field-drift {
    from { transform: translate3d(-1.5%, -1%, 0) scale(1); }
    to { transform: translate3d(1.5%, 1.5%, 0) scale(1.04); }
  }

  /* a whisper of the real glass, so the field is not pure abstraction */
  .field__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
    opacity: 0.14;
    mix-blend-mode: luminosity;
    -webkit-mask-image: linear-gradient(90deg, transparent 30%, #000 75%);
    mask-image: linear-gradient(90deg, transparent 30%, #000 75%);
  }

  .field__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* mono labels pinned to the two process lines (JS keeps them in place) */
  .field__labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .field__label {
    position: absolute;
    right: 4%;
    transform: translateY(-50%);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 800ms ease;
  }

  .field__label--substrate { top: var(--sub-y, 32%); margin-top: -0.9rem; }
  .field__label--source { top: var(--src-y, 84%); margin-top: 1rem; }
  .field__label--d {
    top: calc((var(--sub-y, 32%) + var(--src-y, 84%)) / 2);
    color: rgba(255, 255, 255, 0.8);
  }

  .field[data-ready] .field__label {
    opacity: 1;
  }

  .field__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 7vh, 5rem) clamp(4rem, 9vh, 6rem);
  }

  .field__claim {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
  }

  .field__claim b {
    color: #fff;
    font-weight: 600;
  }

  .field__title {
    max-width: 14ch;
    margin-top: 1rem;
    font-size: clamp(2.5rem, 5.6vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #fff;
  }

  /* each word rises from behind a clip line */
  .field__word {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .field__descriptor {
    font-family: var(--font-mono);
    font-size: 0.94rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
    margin-top: 1.25rem;
  }

  .field__lead {
    font-size: 1.125rem;
    line-height: 1.55;
    max-width: 34rem;
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.86);
  }

  .field__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .field__eyebrow {
    color: rgba(255, 255, 255, 0.7);
    margin-top: 2.25rem;
  }

  /* entrance: staggered rise, 60ms per step */
  .rise {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.6em);
    animation: field-rise 900ms var(--ease-out) forwards;
    animation-delay: calc(120ms + var(--i, 0) * 60ms);
  }

  .field__ctas.rise,
  .field__lead.rise,
  .field__descriptor.rise,
  .field__claim.rise,
  .field__eyebrow.rise {
    display: block;
  }

  .field__ctas.rise {
    display: flex;
  }

  @keyframes field-rise {
    to { opacity: 1; transform: translateY(0); }
  }

  /* marquee of application fields, just above the strip */
  .field__marquee {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    padding-block: 0.7rem;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(28, 16, 44, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .field__track {
    display: flex;
    gap: 3rem;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    animation: field-marquee 48s linear infinite;
  }

  .field__track li {
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .field__track li::after {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--grad-vapor);
    opacity: 0.8;
  }

  @keyframes field-marquee {
    to { transform: translateX(-50%); }
  }

  .field__strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8px;
    background: var(--grad-vapor);
    z-index: 2;
  }

  @media (max-width: 56rem) {
    .field__photo {
      opacity: 0.1;
      -webkit-mask-image: linear-gradient(180deg, transparent 35%, #000 80%);
      mask-image: linear-gradient(180deg, transparent 35%, #000 80%);
    }

    .field__labels {
      font-size: 0.6rem;
    }

    .field__eyebrow {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 40rem) {
    .field__ctas .btn {
      width: 100%;
    }

    .field__labels {
      display: none;
    }

    /* leave the field its own band under the copy */
    .field__content {
      padding-bottom: 11rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field__mesh,
    .field__track {
      animation: none;
    }

    .rise {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  /**
   * Sublimation field. A cheap 2D-canvas particle system:
   *  - particles spawn along the source line, rise with a little lateral
   *    drift, and change colour with height (coral → magenta → violet);
   *  - reaching the substrate they either settle into a thin deposited layer
   *    (per-column buckets, capped) or respawn;
   *  - the pointer pushes nearby vapour aside;
   *  - `d` breathes: the substrate line eases up and down over ~14s.
   */
  const root = document.querySelector<HTMLElement>('[data-field]');
  const canvas = root?.querySelector<HTMLCanvasElement>('.field__canvas');

  if (root && canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);

    const CORAL = [240, 83, 47], MAGENTA = [206, 66, 98], VIOLET = [108, 18, 248];
    const mix = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
    const colour = (t: number) => (t < 0.5 ? mix(CORAL, MAGENTA, t / 0.5) : mix(MAGENTA, VIOLET, (t - 0.5) / 0.5));

    let W = 0, H = 0, narrow = false;
    let glow: HTMLCanvasElement | null = null;
    /* geometry in CSS px: source span, substrate span, line heights */
    let srcY = 0, subY = 0, subBase = 0, x0 = 0, x1 = 0;
    const layout = () => {
      const r = root.getBoundingClientRect();
      W = Math.round(r.width); H = Math.round(r.height);
      canvas.width = W * DPR; canvas.height = H * DPR;
      canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      narrow = W < 640;
      /* phones: the copy fills the band, so the process sits low and right */
      x0 = narrow ? W * 0.3 : W < 900 ? W * 0.5 : W * 0.56;
      x1 = narrow ? W * 0.97 : W * 0.94;
      srcY = narrow ? H * 0.965 : H * 0.84;
      subBase = narrow ? H * 0.8 : H * 0.32;
      glow = null;
      buckets.length = 0;
      for (let i = 0; i < Math.ceil((x1 - x0) / BUCKET) + 1; i++) buckets.push(0);
      root.style.setProperty('--src-y', (srcY / H) * 100 + '%');
    };

    /* deposited layer: height per column bucket */
    const BUCKET = 6, CAP = 9;
    const buckets: number[] = [];

    /* the glowing source line, rendered once per layout */
    const sourceGlow = () => {
      if (glow) return glow;
      const c = document.createElement('canvas');
      c.width = Math.ceil((x1 - x0 + 80) * DPR); c.height = Math.ceil(80 * DPR);
      const g2 = c.getContext('2d')!;
      g2.setTransform(DPR, 0, 0, DPR, 0, 0);
      const g = g2.createLinearGradient(40, 0, x1 - x0 + 40, 0);
      g.addColorStop(0, 'rgba(240,83,47,0)'); g.addColorStop(0.15, 'rgba(240,83,47,0.9)');
      g.addColorStop(0.85, 'rgba(230,78,61,0.9)'); g.addColorStop(1, 'rgba(240,83,47,0)');
      g2.shadowColor = 'rgba(240,83,47,0.9)'; g2.shadowBlur = 24;
      g2.strokeStyle = g; g2.lineWidth = 2; g2.lineCap = 'round';
      g2.beginPath(); g2.moveTo(40, 40); g2.lineTo(x1 - x0 + 40, 40); g2.stroke();
      glow = c;
      return c;
    };

    type P = { x: number; y: number; vx: number; vy: number; s: number; age: number; life: number; ph: number };
    const ps: P[] = [];
    const spawn = (p: P) => {
      p.x = x0 + Math.random() * (x1 - x0);
      p.y = srcY + (Math.random() - 0.5) * 6;
      p.vx = (Math.random() - 0.5) * 0.15;
      p.vy = -(0.35 + Math.random() * 0.55) * (H / 900);
      p.s = 0.9 + Math.random() * 1.7;
      p.age = 0;
      p.life = 1;
      p.ph = Math.random() * Math.PI * 2;
      return p;
    };
    const N = Math.max(120, Math.min(520, Math.round((W || 1200) * (H || 800) / (W < 640 ? 6500 : 3800))));

    let px = -1e4, py = -1e4; // pointer, CSS px in canvas space
    root.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      px = e.clientX - r.left; py = e.clientY - r.top;
      root.style.setProperty('--px', String(px / W));
      root.style.setProperty('--py', String(py / H));
    });
    root.addEventListener('pointerleave', () => { px = py = -1e4; });

    let t0 = performance.now();
    const step = (now: number) => {
      const dt = Math.min(2, (now - t0) / 16.67); t0 = now;
      /* d breathes: substrate drifts ±5% of height over ~14s */
      subY = subBase + Math.sin(now / 2200) * H * (narrow ? 0.02 : 0.05);
      root.style.setProperty('--sub-y', (subY / H) * 100 + '%');

      for (const p of ps) {
        p.age += dt;
        /* lateral drift: two slow sines, phase per particle */
        const rise = (srcY - p.y) / (srcY - subY);
        p.vx += (Math.sin(now / 900 + p.ph + p.y / 60) * 0.02 + Math.sin(now / 1700 - p.ph) * 0.012) * dt;
        p.vx *= 0.96;
        /* pointer pushes the vapour aside */
        const dx = p.x - px, dy = p.y - py, d2 = dx * dx + dy * dy;
        if (d2 < 140 * 140) {
          const f = (1 - Math.sqrt(d2) / 140) * 0.9;
          p.vx += (dx / (Math.sqrt(d2) + 1)) * f * dt;
          p.vy += (dy / (Math.sqrt(d2) + 1)) * f * 0.35 * dt;
        }
        p.x += p.vx * dt * 1.6;
        p.y += p.vy * dt;
        /* condense on the substrate, or leave the frame */
        if (rise >= 1) {
          const b = Math.floor((p.x - x0) / BUCKET);
          if (b >= 0 && b < buckets.length && buckets[b] < CAP && Math.random() < 0.35) buckets[b] += 0.6;
          spawn(p);
        } else if (p.x < -10 || p.x > W + 10 || p.y < -10) {
          spawn(p);
        }
      }
      /* the layer slowly re-evaporates so it never saturates */
      for (let i = 0; i < buckets.length; i++) buckets[i] = Math.max(0, buckets[i] - 0.004 * dt);
    };

    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      /* source: a warm glowing line (cached) */
      const sg = sourceGlow();
      ctx.drawImage(sg, x0 - 40, srcY - 40, sg.width / DPR, sg.height / DPR);
      /* substrate: a cool thin line with the deposited layer beneath it */
      ctx.strokeStyle = 'rgba(255,255,255,0.35)'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x0, subY); ctx.lineTo(x1, subY); ctx.stroke();
      ctx.save();
      ctx.globalCompositeOperation = 'lighter';
      for (let i = 0; i < buckets.length; i++) {
        const h = buckets[i];
        if (h <= 0.05) continue;
        const lg = ctx.createLinearGradient(0, subY, 0, subY + h);
        lg.addColorStop(0, 'rgba(233,220,253,0.9)'); lg.addColorStop(1, 'rgba(108,18,248,0.15)');
        ctx.fillStyle = lg;
        ctx.fillRect(x0 + i * BUCKET, subY + 0.5, BUCKET - 0.5, h);
      }
      /* vapour */
      for (const p of ps) {
        const rise = Math.max(0, Math.min(1, (srcY - p.y) / (srcY - subY)));
        const [r, gg, b] = colour(rise);
        const fadeIn = Math.min(1, p.age / 30);
        const a = (0.25 + 0.55 * (1 - Math.abs(rise - 0.45) * 1.2)) * fadeIn;
        ctx.fillStyle = `rgba(${r},${gg},${b},${Math.max(0.05, a)})`;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.s * (0.8 + rise * 0.5), 0, Math.PI * 2); ctx.fill();
      }
      ctx.restore();
    };

    layout();
    for (let i = 0; i < N; i++) {
      const p = spawn({ x: 0, y: 0, vx: 0, vy: 0, s: 1, age: 0, life: 1, ph: 0 });
      p.y = srcY - Math.random() * (srcY - subBase); // pre-fill the column
      p.age = 40;
      ps.push(p);
    }

    let raf = 0, running = false, visible = true;
    const loop = (now: number) => { step(now); draw(); raf = requestAnimationFrame(loop); };
    const start = () => { if (!running && visible && !document.hidden) { running = true; t0 = performance.now(); raf = requestAnimationFrame(loop); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    if (reduce) {
      /* one settled still: advance the simulation without drawing */
      const now = performance.now();
      for (let i = 0; i < 420; i++) step(now + i * 16.67);
      draw();
    } else {
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }, { threshold: 0.05 }).observe(root);
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    }

    let rt = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(rt);
      rt = window.setTimeout(() => { layout(); ps.forEach(spawn); if (reduce) draw(); }, 150);
    });

    root.setAttribute('data-ready', '');
  }
</script>
