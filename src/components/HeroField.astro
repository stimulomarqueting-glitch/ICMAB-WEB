---
/**
 * Home hero, "floating device" variant. The product photo sits on a plate
 * that tilts in 3D with the pointer (perspective + layers at different
 * depths: halo and shadow behind, photo, a sheen sweeping the glass, and
 * the vapour in front). Particles rise out of the chamber in the photo,
 * cooling from coral to violet as they climb — the process, live, on the
 * real device. A slow marquee of application fields runs along the bottom.
 *
 * Motion is progressive enhancement: no JS → static plate and copy;
 * prefers-reduced-motion → no tilt, no float, one still frame of vapour.
 * The loop pauses off-screen and when the tab is hidden.
 */
import { brand } from '../config/brand';
import { getContent } from '../content';
import { getLocale, localePath } from '../i18n';

const locale = getLocale(Astro.url);
const { home } = getContent(locale);
const t = home.hero;
const lp = (href: string) => localePath(locale, href);

const claim = locale === 'es' ? brand.claimEs : brand.claim;
const claimMatch = claim.match(/^(.*\s)(\S+?)(\.?)$/);
const claimLead = claimMatch ? claimMatch[1] : '';
const claimEmph = claimMatch ? claimMatch[2] : claim;
const claimEnd = claimMatch ? claimMatch[3] : '';

const words = t.headline.split(' ');
const marquee = [...t.field.marquee, ...t.field.marquee];
---

<section class="field" aria-labelledby="hero-title" data-field>
  <div class="field__mesh" aria-hidden="true"></div>

  <div class="container field__grid">
    <div class="field__content">
      <p class="field__claim rise" style="--i: 0">{claimLead}<b>{claimEmph}</b>{claimEnd}</p>
      <h1 class="field__title" id="hero-title">
        {words.map((w, i) => (
          <>
            <span class="field__word"><span class="rise" style={`--i: ${i + 1}`}>{w}</span></span>{' '}
          </>
        ))}
      </h1>
      <p class="field__descriptor rise" style={`--i: ${words.length + 1}`}>{t.descriptor}</p>
      <p class="field__lead rise" style={`--i: ${words.length + 2}`}>{t.lead}</p>
      <div class="field__ctas rise" style={`--i: ${words.length + 3}`}>
        <a class="btn" href={lp('/contact')} data-cta-source="hero">{t.ctaPrimary}</a>
        <a class="btn btn--glass" href={lp('/product')} data-cta-source="hero-product">{t.ctaSecondary}</a>
      </div>
      <p class="eyebrow field__eyebrow rise" style={`--i: ${words.length + 4}`}>{t.eyebrow}</p>
    </div>

    {/* the device: a plate in perspective, layers at different depths */}
    <div class="field__stage" aria-hidden="true">
      <div class="plate" data-plate>
        <div class="plate__float">
          <div class="plate__halo"></div>
          <div class="plate__shadow"></div>
          <div class="plate__card">
            <img class="plate__img" src="/img/product-table.jpg" alt="" width="1100" height="619" decoding="async" fetchpriority="high" />
            <div class="plate__tint"></div>
            <div class="plate__sheen"></div>
          </div>
          <canvas class="plate__vapour" data-vapour></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="field__marquee" aria-hidden="true">
    <ul class="field__track">
      {marquee.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
  <div class="field__strip" aria-hidden="true"></div>
</section>

<style>
  .field {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(38rem, calc(100svh - var(--header-h)), 56rem);
    overflow: hidden;
    background: var(--bg-inverse);
    color: var(--text-on-dark);
    isolation: isolate;
    --px: 0.5; /* pointer, 0–1 */
    --py: 0.5;
    --rx: 0deg; /* plate tilt */
    --ry: 0deg;
  }

  /* slow gradient mesh: heat low-left, vacuum high-right; the pointer steers it a little */
  .field__mesh {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(40% 40% at calc(15% + var(--px) * 10%) 95%, rgba(240, 83, 47, 0.26), transparent 70%),
      radial-gradient(45% 55% at calc(72% + var(--px) * 6%) calc(25% + var(--py) * 10%), rgba(108, 18, 248, 0.4), transparent 70%),
      radial-gradient(30% 35% at 50% 60%, rgba(206, 66, 98, 0.16), transparent 70%),
      linear-gradient(180deg, #2a1845 0%, #231536 50%, #1a0f2c 100%);
    animation: field-drift 22s ease-in-out infinite alternate;
  }

  @keyframes field-drift {
    from { transform: translate3d(-1.5%, -1%, 0) scale(1); }
    to { transform: translate3d(1.5%, 1.5%, 0) scale(1.04); }
  }

  .field__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 10fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: clamp(3rem, 7vh, 5rem) clamp(4.5rem, 9vh, 6.5rem);
  }

  /* ── copy ─────────────────────────────────────────────────────────── */
  .field__claim {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
  }

  .field__claim b {
    color: #fff;
    font-weight: 600;
  }

  .field__title {
    max-width: 14ch;
    margin-top: 1rem;
    font-size: clamp(2.5rem, 4.6vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .field__word {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .field__descriptor {
    font-family: var(--font-mono);
    font-size: 0.94rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
    margin-top: 1.25rem;
  }

  .field__lead {
    font-size: 1.125rem;
    line-height: 1.55;
    max-width: 32rem;
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.86);
  }

  .field__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .field__eyebrow {
    color: rgba(255, 255, 255, 0.7);
    margin-top: 2.25rem;
  }

  .rise {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.6em);
    animation: field-rise 900ms var(--ease-out) forwards;
    animation-delay: calc(120ms + var(--i, 0) * 60ms);
  }

  .field__claim.rise,
  .field__descriptor.rise,
  .field__lead.rise,
  .field__eyebrow.rise {
    display: block;
  }

  .field__ctas.rise {
    display: flex;
  }

  @keyframes field-rise {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── the plate ────────────────────────────────────────────────────── */
  .field__stage {
    perspective: 1400px;
    perspective-origin: 50% 40%;
  }

  .plate {
    position: relative;
    width: 108%; /* bleeds a little past the container edge */
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 220ms ease-out;
    will-change: transform;
  }

  .plate__float {
    position: relative;
    transform-style: preserve-3d;
    animation: plate-float 7s ease-in-out infinite;
  }

  @keyframes plate-float {
    50% { transform: translateY(-10px); }
  }

  .plate__card {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 40px 90px rgba(10, 4, 24, 0.55);
    transform: translateZ(0);
  }

  .plate__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
  }

  /* warm-to-cool duotone, light enough to keep the glass legible */
  .plate__tint {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, rgba(240, 83, 47, 0.55) 0%, rgba(206, 66, 98, 0.45) 45%, rgba(108, 18, 248, 0.6) 100%);
    mix-blend-mode: multiply;
    opacity: 0.85;
  }

  /* a specular band that follows the pointer across the glass */
  .plate__sheen {
    position: absolute;
    inset: -20%;
    background: linear-gradient(
      115deg,
      transparent calc(var(--px) * 100% - 22%),
      rgba(255, 255, 255, 0.18) calc(var(--px) * 100% - 4%),
      rgba(255, 255, 255, 0.05) calc(var(--px) * 100% + 4%),
      transparent calc(var(--px) * 100% + 20%)
    );
    mix-blend-mode: screen;
    transform: translateZ(20px);
    pointer-events: none;
  }

  /* depth behind: a violet halo and a soft drop shadow that slides against the tilt */
  .plate__halo {
    position: absolute;
    inset: -12% -8%;
    background: radial-gradient(50% 50% at 60% 55%, rgba(108, 18, 248, 0.55), transparent 70%);
    filter: blur(24px);
    transform: translateZ(-140px) scale(1.1);
  }

  .plate__shadow {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -8%;
    height: 24%;
    background: radial-gradient(50% 50% at 50% 50%, rgba(8, 3, 20, 0.7), transparent 70%);
    filter: blur(18px);
    transform: translateZ(-90px) translateX(calc(var(--ry) * -1.4)) translateY(calc(var(--rx) * 1.2));
  }

  /* the vapour lives in front of the glass and overflows the card */
  .plate__vapour {
    position: absolute;
    left: -25%;
    right: -25%;
    top: -70%;
    bottom: -10%;
    width: 150%;
    height: 180%;
    transform: translateZ(70px);
    pointer-events: none;
  }

  /* ── marquee + strip ──────────────────────────────────────────────── */
  .field__marquee {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    padding-block: 0.7rem;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(28, 16, 44, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .field__track {
    display: flex;
    gap: 3rem;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    animation: field-marquee 48s linear infinite;
  }

  .field__track li {
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .field__track li::after {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--grad-vapor);
    opacity: 0.8;
  }

  @keyframes field-marquee {
    to { transform: translateX(-50%); }
  }

  .field__strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8px;
    background: var(--grad-vapor);
    z-index: 2;
  }

  /* ── responsive ───────────────────────────────────────────────────── */
  @media (max-width: 64rem) {
    .field__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .plate {
      width: 104%;
    }
  }

  /* stacked: the plate sits under the copy, capped so the band stays compact */
  @media (max-width: 56rem) {
    .field__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .plate {
      width: min(100%, 34rem);
      margin-inline: auto;
    }

    .plate__card {
      aspect-ratio: 16 / 10;
    }

    .field__eyebrow {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 40rem) {
    .field__ctas .btn {
      width: 100%;
    }

    .field__grid {
      padding-bottom: 5.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field__mesh,
    .field__track,
    .plate__float {
      animation: none;
    }

    .plate {
      transition: none;
    }

    .rise {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  /**
   * Plate tilt + vapour.
   *  - pointer over the section → tilt (±7° / ±10°), sheen and mesh follow;
   *    leaving eases the plate back;
   *  - vapour: particles spawn in an ellipse over the chamber in the photo,
   *    rise with a light drift, cool from coral to violet, fade out high up;
   *    the pointer pushes them aside.
   */
  const root = document.querySelector<HTMLElement>('[data-field]');
  const plate = root?.querySelector<HTMLElement>('[data-plate]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-vapour]');

  if (root && plate && canvas) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ctx = canvas.getContext('2d')!;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);

    /* ── tilt ─────────────────────────────────────────────────────── */
    let px = -1e4, py = -1e4; // pointer in canvas space
    if (!reduce) {
      root.addEventListener('pointermove', (e) => {
        const r = root.getBoundingClientRect();
        const nx = (e.clientX - r.left) / r.width - 0.5;
        const ny = (e.clientY - r.top) / r.height - 0.5;
        root.style.setProperty('--px', String(nx + 0.5));
        root.style.setProperty('--py', String(ny + 0.5));
        root.style.setProperty('--ry', (nx * 10).toFixed(2) + 'deg');
        root.style.setProperty('--rx', (-ny * 7).toFixed(2) + 'deg');
        const c = canvas.getBoundingClientRect();
        px = e.clientX - c.left; py = e.clientY - c.top;
      });
      root.addEventListener('pointerleave', () => {
        root.style.setProperty('--rx', '0deg');
        root.style.setProperty('--ry', '0deg');
        px = py = -1e4;
      });
    }

    /* ── vapour ───────────────────────────────────────────────────── */
    const CORAL = [240, 83, 47], MAGENTA = [206, 66, 98], VIOLET = [108, 18, 248];
    const mix = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
    const colour = (t: number) => (t < 0.5 ? mix(CORAL, MAGENTA, t / 0.5) : mix(MAGENTA, VIOLET, (t - 0.5) / 0.5));

    let W = 0, H = 0;
    /* emitter: the chamber sits at ~73% / 56% of the card; the canvas is
       150% × 180% of the card, offset 25% left and 70% up */
    let ex = 0, ey = 0, erx = 0, ery = 0, travel = 0;
    const layout = () => {
      const r = canvas.getBoundingClientRect();
      W = Math.round(r.width); H = Math.round(r.height);
      canvas.width = W * DPR; canvas.height = H * DPR;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      const cardW = W / 1.5, cardH = H / 1.8;
      const cardX = cardW * 0.25, cardY = cardH * 0.7;
      ex = cardX + cardW * 0.73; ey = cardY + cardH * 0.56;
      erx = cardW * 0.07; ery = cardH * 0.1;
      travel = ey - cardY * 0.15; // how far up the vapour lives
    };

    type P = { x: number; y: number; vx: number; vy: number; s: number; age: number; ph: number; span: number };
    const ps: P[] = [];
    const spawn = (p: P) => {
      const a = Math.random() * Math.PI * 2, rr = Math.sqrt(Math.random());
      p.x = ex + Math.cos(a) * erx * rr;
      p.y = ey + Math.sin(a) * ery * rr;
      p.vx = (Math.random() - 0.5) * 0.12;
      p.vy = -(0.3 + Math.random() * 0.5) * (H / 800);
      p.s = 1.1 + Math.random() * 1.9;
      p.age = 0;
      p.ph = Math.random() * Math.PI * 2;
      p.span = 0.6 + Math.random() * 0.4; // fraction of travel before it fades
      return p;
    };
    const N = window.innerWidth < 640 ? 140 : 320;

    let t0 = performance.now();
    const step = (now: number) => {
      const dt = Math.min(2, (now - t0) / 16.67); t0 = now;
      for (const p of ps) {
        p.age += dt;
        p.vx += (Math.sin(now / 900 + p.ph + p.y / 60) * 0.02 + Math.sin(now / 1700 - p.ph) * 0.012) * dt;
        p.vx *= 0.96;
        const dx = p.x - px, dy = p.y - py, d2 = dx * dx + dy * dy;
        if (d2 < 120 * 120) {
          const d = Math.sqrt(d2) + 1, f = (1 - d / 120) * 0.9;
          p.vx += (dx / d) * f * dt;
          p.vy += (dy / d) * f * 0.35 * dt;
        }
        p.x += p.vx * dt * 1.6;
        p.y += p.vy * dt;
        const rise = (ey - p.y) / travel;
        if (rise > p.span || p.x < -10 || p.x > W + 10 || p.y < -10) spawn(p);
      }
    };

    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'lighter';
      for (const p of ps) {
        const rise = Math.max(0, Math.min(1, (ey - p.y) / travel));
        const [r, g, b] = colour(Math.min(1, rise / 0.8));
        const fadeIn = Math.min(1, p.age / 25);
        const fadeOut = 1 - Math.max(0, (rise - p.span * 0.7) / (p.span * 0.3));
        const a = (0.4 + 0.55 * (1 - rise)) * fadeIn * Math.max(0, fadeOut);
        ctx.fillStyle = `rgba(${r},${g},${b},${Math.max(0.03, a).toFixed(3)})`;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.s * (0.8 + rise * 0.6), 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalCompositeOperation = 'source-over';
    };

    layout();
    for (let i = 0; i < N; i++) {
      const p = spawn({ x: 0, y: 0, vx: 0, vy: 0, s: 1, age: 0, ph: 0, span: 1 });
      p.y = ey - Math.random() * travel * p.span; // pre-fill the plume
      p.age = 40;
      ps.push(p);
    }

    let raf = 0, running = false, visible = true;
    const loop = (now: number) => { step(now); draw(); raf = requestAnimationFrame(loop); };
    const start = () => { if (!running && visible && !document.hidden) { running = true; t0 = performance.now(); raf = requestAnimationFrame(loop); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    if (reduce) {
      const now = performance.now();
      for (let i = 0; i < 300; i++) step(now + i * 16.67);
      draw();
    } else {
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }, { threshold: 0.05 }).observe(root);
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    }

    let rt = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(rt);
      rt = window.setTimeout(() => { layout(); ps.forEach(spawn); if (reduce) draw(); }, 150);
    });
  }
</script>
