---
/**
 * The device drawn as an annotated paper figure: material source (m),
 * temperature (T), pressure·time (P·t), adjustable distance (d), particles
 * depositing onto the target surface, and the parameter chips underneath.
 *
 * PLACEHOLDER: replace with real device photography / a validated technical
 * schematic when assets are available (keep the same figure/caption frame).
 */
interface Props {
  alt: string;
  caption?: string;
  /** figure number label, universal scientific abbreviation */
  figNum?: string;
}

const { alt, caption, figNum = 'FIG. 01' } = Astro.props;

// Deterministic pseudo-random particle field inside the deposition cone.
const particles = Array.from({ length: 22 }, (_, i) => {
  const seed = (i * 41) % 100;
  return {
    cx: 128 + ((seed * 1.9) % 104),
    delay: (i % 11) * 0.6,
    duration: 4.5 + (seed % 5) * 0.7,
    r: 1.3 + (seed % 3) * 0.5,
    o: 0.3 + (seed % 5) * 0.12,
  };
});
---

<figure class="fig">
  <div class="fig__frame panel" role="img" aria-label={alt}>
    <svg viewBox="0 0 360 400" fill="none" aria-hidden="true" class="fig__svg">
      <!-- corner registration ticks -->
      <path d="M14 22h12M20 16v12M334 22h12M340 16v12M14 378h12M20 372v12M334 378h12M340 372v12" stroke="rgba(148,179,195,0.35)" stroke-width="1" />

      <!-- material source, annotated m -->
      <rect x="150" y="42" width="60" height="16" fill="#f4f6f5" />
      <circle cx="141" cy="50" r="3" fill="#5aa9ff" />
      <path d="M212 50h36" stroke="rgba(148,179,195,0.35)" stroke-width="1" />
      <text x="252" y="53" font-size="9" letter-spacing="1.5" fill="#74879a" font-family="IBM Plex Mono, monospace"><tspan font-style="italic" fill="#f4f6f5">m</tspan> · SOURCE</text>

      <!-- sublimation waves, annotated T -->
      <path d="M158 68c2 3-2 5 0 8M180 68c2 3-2 5 0 8M202 68c2 3-2 5 0 8" stroke="#8fe9dc" stroke-width="1.6" stroke-linecap="round" />
      <path d="M148 72h-30" stroke="rgba(148,179,195,0.35)" stroke-width="1" />
      <text x="96" y="75" font-size="9" letter-spacing="1.5" fill="#74879a" font-family="IBM Plex Mono, monospace"><tspan font-style="italic" fill="#f4f6f5">T</tspan></text>

      <!-- deposition cone, annotated P·t -->
      <path d="M150 84 L118 268 M210 84 L242 268" stroke="rgba(148,179,195,0.35)" stroke-width="1" stroke-dasharray="2 5" />
      <path d="M112 176h-26" stroke="rgba(148,179,195,0.35)" stroke-width="1" />
      <text x="46" y="179" font-size="9" letter-spacing="1.5" fill="#74879a" font-family="IBM Plex Mono, monospace"><tspan font-style="italic" fill="#f4f6f5">P</tspan> · <tspan font-style="italic" fill="#f4f6f5">t</tspan></text>

      <!-- travelling particles -->
      <g class="fig__particles">
        {particles.map((p) => (
          <circle
            class="fig__particle"
            cx={p.cx}
            cy="92"
            r={p.r}
            fill="#2fd9c3"
            opacity={p.o}
            style={`--o:${p.o}; animation-delay:${p.delay}s; animation-duration:${p.duration}s;`}
          />
        ))}
      </g>

      <!-- adjustable distance d -->
      <path d="M300 60v212" stroke="#74879a" stroke-width="1" />
      <path d="M296 68 L300 60 L304 68 M296 264 L300 272 L304 264" stroke="#74879a" stroke-width="1" />
      <path d="M294 166h12" stroke="rgba(148,179,195,0.35)" stroke-width="1" />
      <text x="312" y="170" font-size="12" font-style="italic" fill="#2fd9c3" font-family="IBM Plex Mono, monospace">d</text>

      <!-- settled particles + deposited layer -->
      <g fill="#2fd9c3">
        <circle cx="126" cy="272" r="2" opacity="0.6" /><circle cx="142" cy="270" r="2" /><circle cx="158" cy="273" r="2" opacity="0.75" /><circle cx="176" cy="270" r="2" /><circle cx="194" cy="273" r="2" opacity="0.7" /><circle cx="212" cy="270" r="2" /><circle cx="230" cy="272" r="2" opacity="0.6" />
      </g>
      <rect x="112" y="278" width="136" height="4" fill="#2fd9c3" />

      <!-- target surface with section hatching -->
      <path d="M56 282h248" stroke="#f4f6f5" stroke-width="2" />
      <path d="M64 292l10-8M84 292l10-8M104 292l10-8M124 292l10-8M144 292l10-8M164 292l10-8M184 292l10-8M204 292l10-8M224 292l10-8M244 292l10-8M264 292l10-8M284 292l10-8" stroke="rgba(148,179,195,0.35)" stroke-width="1" />
      <text x="180" y="320" text-anchor="middle" font-size="9" letter-spacing="2" fill="#74879a" font-family="IBM Plex Mono, monospace">TARGET SURFACE</text>

      <!-- parameter chips: d P T t m -->
      <g font-family="IBM Plex Mono, monospace" font-size="10" text-anchor="middle">
        <rect x="86" y="344" width="34" height="20" rx="4" fill="#151e28" stroke="rgba(148,179,195,0.25)" /><text x="103" y="358" font-style="italic" fill="#8fe9dc">d</text>
        <rect x="128" y="344" width="34" height="20" rx="4" fill="#151e28" stroke="rgba(148,179,195,0.25)" /><text x="145" y="358" font-style="italic" fill="#8fe9dc">P</text>
        <rect x="170" y="344" width="34" height="20" rx="4" fill="#151e28" stroke="rgba(148,179,195,0.25)" /><text x="187" y="358" font-style="italic" fill="#8fe9dc">T</text>
        <rect x="212" y="344" width="34" height="20" rx="4" fill="#151e28" stroke="rgba(148,179,195,0.25)" /><text x="229" y="358" font-style="italic" fill="#8fe9dc">t</text>
        <rect x="254" y="344" width="34" height="20" rx="4" fill="#151e28" stroke="rgba(148,179,195,0.25)" /><text x="271" y="358" font-style="italic" fill="#8fe9dc">m</text>
      </g>
    </svg>
  </div>
  {caption && (
    <figcaption class="fig__caption">
      <span class="fig__caption-num">{figNum}</span>
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .fig {
    margin: 0;
  }

  .fig__frame {
    background:
      radial-gradient(circle, rgba(143, 233, 220, 0.07) 1px, transparent 1.2px) 0 0 / 18px 18px,
      var(--bg-panel);
  }

  .fig__svg {
    width: 100%;
    height: auto;
  }

  .fig__caption {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-3);
  }

  .fig__caption-num {
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent-2);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fig__particle {
      animation-name: fig-fall;
      animation-iteration-count: infinite;
      animation-timing-function: linear;
    }

    @keyframes fig-fall {
      0% { transform: translateY(0); opacity: 0; }
      12% { opacity: var(--o, 0.5); }
      82% { opacity: var(--o, 0.5); }
      96% { transform: translateY(176px); opacity: 0; }
      100% { transform: translateY(176px); opacity: 0; }
    }
  }
</style>
