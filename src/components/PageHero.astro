---
/**
 * Interior page hero: mono kicker + h1 + short lead, with optional primary
 * CTA and optional photo column. Light background — the full-bleed process
 * hero is reserved for the home page. The copy rises in word by word, and
 * a photo sits on a plate that tilts gently with the pointer (motion-safe).
 */
import { getLocale, localePath } from '../i18n';

interface Props {
  kicker: string;
  /** optional right-aligned mono note on the kicker row */
  kickerNote?: string;
  title: string;
  lead?: string;
  cta?: { label: string; href: string; ctaSource: string };
  photo?: { src: string; alt: string };
  id?: string;
}

const { kicker, kickerNote, title, lead, cta, photo, id = 'page-title' } = Astro.props;
const ctaHref = cta ? localePath(getLocale(Astro.url), cta.href) : undefined;
const words = title.split(' ');
---

<section class="sec phero" aria-labelledby={id} data-phero>
  <div class:list={['container', 'phero__grid', { 'phero__grid--photo': !!photo }]}>
    <div>
      {kickerNote ? (
        <div class="phero__row rise-in" style="--i: 0">
          <p class="eyebrow">{kicker}</p>
          <p class="eyebrow phero__note">{kickerNote}</p>
        </div>
      ) : (
        <p class="eyebrow rise-in" style="--i: 0">{kicker}</p>
      )}
      <h1 class="phero__title" id={id}>
        {words.map((w, i) => (
          <>
            <span class="phero__word"><span class="rise-in" style={`--i: ${i + 1}`}>{w}</span></span>{' '}
          </>
        ))}
      </h1>
      {lead && <p class="lead rise-in" style={`--i: ${words.length + 1}`}>{lead}</p>}
      {cta && (
        <div class="phero__cta rise-in" style={`--i: ${words.length + 2}`}>
          <a class="btn" href={ctaHref} data-cta-source={cta.ctaSource}>{cta.label}</a>
        </div>
      )}
    </div>
    {photo && (
      <div class="phero__stage" aria-hidden="false">
        <div class="phero__plate">
          <span class="phero__halo" aria-hidden="true"></span>
          <img
            class="phero__photo"
            src={photo.src}
            alt={photo.alt}
            width="1000"
            height="750"
            fetchpriority="high"
          />
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .phero {
    padding-block: clamp(2.75rem, 5.5vw, 4.5rem) clamp(2rem, 4vw, 3rem);
    /* the plate's halo may bleed past the container; clip without creating a scroll box */
    overflow-x: clip;
    --rx: 0deg;
    --ry: 0deg;
  }

  .phero__grid--photo {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .phero__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .phero__title {
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    line-height: 1.06;
    margin-top: 0.9rem;
    max-width: 22ch;
  }

  .phero__word {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .phero__word .rise-in {
    display: inline-block;
  }

  .lead.rise-in,
  .eyebrow.rise-in {
    display: block;
  }

  .phero__cta {
    margin-top: 1.75rem;
  }

  /* the photo on a plate in perspective, halo behind */
  .phero__stage {
    perspective: 1400px;
  }

  .phero__plate {
    position: relative;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: transform 260ms ease-out;
  }

  .phero__halo {
    position: absolute;
    inset: -10% -6%;
    background: radial-gradient(55% 55% at 55% 55%, rgba(108, 18, 248, 0.22), transparent 70%);
    filter: blur(22px);
    transform: translateZ(-80px);
    pointer-events: none;
  }

  .phero__photo {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 62% center;
    border: 1px solid var(--border-violet-soft);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 56rem) {
    .phero__grid--photo {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .phero__photo {
      aspect-ratio: 16 / 10;
    }

    .phero__note {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phero__plate {
      transition: none;
    }
  }
</style>

<script>
  /* the plate tilts with the pointer anywhere over the hero; eases back on leave */
  const hero = document.querySelector<HTMLElement>('[data-phero]');
  const plate = hero?.querySelector('.phero__plate');
  if (hero && plate && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      const nx = (e.clientX - r.left) / r.width - 0.5;
      const ny = (e.clientY - r.top) / r.height - 0.5;
      hero.style.setProperty('--ry', (nx * 8).toFixed(2) + 'deg');
      hero.style.setProperty('--rx', (-ny * 6).toFixed(2) + 'deg');
    });
    hero.addEventListener('pointerleave', () => {
      hero.style.setProperty('--rx', '0deg');
      hero.style.setProperty('--ry', '0deg');
    });
  }
</script>
