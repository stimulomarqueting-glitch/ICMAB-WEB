---
/**
 * Contextual conversion band — a flat raised chapter band, no gradients.
 * `source` feeds the cta_source lead-tracking (see scripts/leadTracking.ts).
 */
interface Props {
  title: string;
  text: string;
  button: string;
  source: string;
}

const { title, text, button, source } = Astro.props;
---

<aside class="ctaband" aria-label={title}>
  <div class="container ctaband__inner reveal">
    <div class="ctaband__copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="btn btn--primary" href="#waitlist" data-cta-source={source}>{button}</a>
  </div>
</aside>

<style>
  .ctaband {
    background: var(--bg-inverse);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .ctaband__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .ctaband__copy h2 {
    color: var(--text-on-dark);
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .ctaband__copy p {
    margin: 0;
    color: var(--text-on-dark-2);
    font-size: 1rem;
    line-height: 1.65;
    max-width: 38rem;
  }

  .ctaband__inner > .btn {
    flex: 0 0 auto;
  }

  @media (max-width: 48rem) {
    .ctaband__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .ctaband__inner > .btn {
      width: 100%;
    }
  }
</style>
