---
/**
 * MatSurfer isotype — the client's original file (public/brand/isotipo.svg),
 * shown as an image so it is never redrawn. `size` is the rendered height
 * in px; the width follows the file's own proportions.
 */
interface Props {
  size?: number;
}

const { size = 26 } = Astro.props;
const width = Math.round(size * (298 / 481) * 10) / 10;
---

<img src="/brand/isotipo.svg" width={width} height={size} alt="" aria-hidden="true" decoding="async" />
