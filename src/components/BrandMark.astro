---
/**
 * MatSurfer brand mark — outlined deposition vessel: gradient stroke
 * (violet vapour → coral deposit) broken mid-height, particles inside
 * coloured by their position along the same gradient.
 * Vectorised from the official logo; `size` is the rendered height in px.
 */
interface Props {
  size?: number;
}

const { size = 26 } = Astro.props;
const width = Math.round(size * (68 / 120));
---

<svg width={width} height={size} viewBox="0 0 68 120" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id="ms-cap" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="120">
      <stop offset="0" stop-color="#6C12F8" />
      <stop offset="0.3" stop-color="#A72F9E" />
      <stop offset="0.55" stop-color="#CE4262" />
      <stop offset="1" stop-color="#F0532F" />
    </linearGradient>
  </defs>
  <path
    d="M 9.64 57 L 11.55 15 Q 12 5 22 5 L 46 5 Q 56 5 56.45 15 L 58.36 57"
    stroke="url(#ms-cap)"
    stroke-width="7"
    stroke-linecap="round"
  />
  <path
    d="M 8.91 73 L 7.55 103 Q 7 115 19 115 L 49 115 Q 61 115 60.45 103 L 59.09 73"
    stroke="url(#ms-cap)"
    stroke-width="7"
    stroke-linecap="round"
  />
  <circle cx="24" cy="30" r="3.2" fill="url(#ms-cap)" />
  <circle cx="46" cy="21" r="2.6" fill="url(#ms-cap)" />
  <circle cx="42" cy="46" r="5.5" fill="url(#ms-cap)" />
  <circle cx="22" cy="59" r="2.8" fill="url(#ms-cap)" />
  <circle cx="48" cy="71" r="3" fill="url(#ms-cap)" />
  <circle cx="17" cy="84" r="5" fill="url(#ms-cap)" />
  <circle cx="33" cy="104.5" r="6.5" fill="url(#ms-cap)" />
</svg>
