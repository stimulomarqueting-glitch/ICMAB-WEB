---
import { getContent, type Locale } from '../content';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).applications;
---

<section class="sec hairtop mist" id="applications" aria-labelledby="applications-title">
  <div class="container">
    <SectionHeader
      kicker={t.kicker}
      kickerNote={t.kickerNote}
      title={t.title}
      id="applications-title"
    />

    <div class="apps__grid">
      {t.items.map((app) => (
        <article class="panel apps__card reveal">
          <span class="apps__sub">{app.sub}</span>
          <h3>{app.name}</h3>
          <p>{app.text}</p>
        </article>
      ))}
    </div>

    <div class="apps__ctaline reveal">
      <a class="btn" href="#waitlist" data-cta-source="applications">{t.ctaButton}</a>
      <span>{t.ctaNote}</span>
    </div>
  </div>
</section>

<style>
  .apps__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .apps__card {
    padding: 1.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .apps__sub {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    color: var(--violet-dark);
    letter-spacing: 0.02em;
  }

  .apps__card h3 {
    font-family: var(--font-body);
    font-size: 1.19rem;
  }

  .apps__card p {
    font-size: 0.88rem;
    line-height: 1.55;
    flex: 1;
  }

  .apps__ctaline {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  .apps__ctaline span {
    font-size: 0.94rem;
    color: var(--text-body);
  }

  @media (max-width: 56rem) {
    .apps__grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 40rem) {
    .apps__grid { grid-template-columns: 1fr; }
  }
</style>
