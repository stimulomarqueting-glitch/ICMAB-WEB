---
/**
 * Identity-system figure for the Applications section: the capsule isotype
 * with callout lines — the device stays the same, different points of the
 * interior read as application fields (from the approved brand system).
 * Gradient runs coral (top) → violet (bottom) as in the identity artwork.
 */
interface Props {
  alt: string;
  caption: string;
  /** order: oleds, sensors, perovskites, coatings, spm */
  labels: [string, string, string, string, string];
}

const { alt, caption, labels } = Astro.props;
const [oleds, sensors, perovskites, coatings, spm] = labels;

/* dot field inside the capsule — smaller/coral on top, larger/violet below */
const dots: [number, number, number][] = [
  [280, 42, 4],
  [258, 58, 3.5], [298, 58, 4.5],
  [242, 74, 3], [275, 74, 5], [315, 76, 3.5],
  [255, 92, 4.5], [292, 92, 5.5],
  [240, 110, 4], [275, 110, 6], [310, 112, 5],
  [258, 130, 5.5], [292, 130, 6.5], [320, 132, 4],
  [242, 150, 5], [275, 150, 7], [308, 152, 6],
  [260, 172, 6.5], [292, 172, 7.5], [320, 174, 5.5],
  [244, 194, 6], [276, 196, 8.5], [310, 196, 7],
  [262, 218, 8], [294, 220, 9], [322, 220, 6.5],
  [246, 244, 7.5], [278, 246, 10], [310, 246, 8.5],
  [264, 272, 9.5], [294, 274, 11],
];

/* colour by height: coral → magenta → violet */
function dotColor(cy: number): string {
  const t = Math.min(1, Math.max(0, (cy - 40) / 240));
  const mix = (a: number, b: number, k: number) => Math.round(a + (b - a) * k);
  const stops: [number, number, number][] = [[240, 83, 47], [206, 66, 98], [108, 18, 248]];
  const [c1, c2] = t < 0.5 ? [stops[0], stops[1]] : [stops[1], stops[2]];
  const k = t < 0.5 ? t * 2 : (t - 0.5) * 2;
  return `rgb(${mix(c1[0], c2[0], k)},${mix(c1[1], c2[1], k)},${mix(c1[2], c2[2], k)})`;
}

/* callouts: [target dot x, y, ring r, side, label, elbow y] */
const callouts: { x: number; y: number; r: number; side: 'l' | 'r'; label: string }[] = [
  { x: 298, y: 58, r: 10, side: 'r', label: oleds },
  { x: 308, y: 152, r: 12, side: 'r', label: sensors },
  { x: 310, y: 246, r: 14, side: 'r', label: coatings },
  { x: 242, y: 150, r: 11, side: 'l', label: perovskites },
  { x: 264, y: 272, r: 15, side: 'l', label: spm },
];
---

<figure class="isotype reveal">
  <svg viewBox="0 0 560 330" role="img" aria-label={alt} class="isotype__svg">
    <defs>
      <linearGradient id="iso-cap" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#F0532F" />
        <stop offset="0.5" stop-color="#CE4262" />
        <stop offset="0.75" stop-color="#A72F9E" />
        <stop offset="1" stop-color="#6C12F8" />
      </linearGradient>
    </defs>

    <!-- capsule -->
    <rect x="215" y="12" width="130" height="306" rx="65" fill="none" stroke="url(#iso-cap)" stroke-width="6" />

    <!-- dot field -->
    {dots.map(([cx, cy, r]) => (
      <circle cx={cx} cy={cy} r={r} fill={dotColor(cy)} />
    ))}

    <!-- callouts -->
    {callouts.map((c) => {
      const edgeX = c.side === 'r' ? c.x + c.r : c.x - c.r;
      const endX = c.side === 'r' ? 420 : 140;
      const textX = c.side === 'r' ? 428 : 132;
      return (
        <>
          <circle cx={c.x} cy={c.y} r={c.r} fill="none" stroke="#26241F" stroke-width="1.5" />
          <line x1={edgeX} y1={c.y} x2={endX} y2={c.y} stroke="#57534A" stroke-width="1.2" />
          <circle cx={endX} cy={c.y} r="2" fill="#26241F" />
          <text
            x={textX}
            y={c.y + 4.5}
            font-family="Manrope, sans-serif"
            font-size="15"
            font-weight="600"
            fill="#26241F"
            text-anchor={c.side === 'r' ? 'start' : 'end'}
          >
            {c.label}
          </text>
        </>
      );
    })}
  </svg>
  <figcaption class="isotype__caption">{caption}</figcaption>
</figure>

<style>
  .isotype {
    margin: 2.25rem auto 0;
    max-width: 36rem;
  }

  .isotype__svg {
    width: 100%;
    height: auto;
  }

  .isotype__caption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    text-align: center;
  }
</style>
