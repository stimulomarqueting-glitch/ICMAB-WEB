---
import { getContent, type Locale } from '../content';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).problem;
---

<section class="sec hairtop mist" id="problem" aria-labelledby="problem-title">
  <div class="container">
    <SectionHeader kicker={t.kicker} title={t.title} lead={t.lead} id="problem-title" />
    <div class="prob__cards">
      {t.cards.map((card) => (
        <article class="panel prob__card reveal">
          <span class="prob__tag">{card.tag}</span>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .prob__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.25rem;
  }

  .prob__card {
    padding: 1.75rem;
  }

  .prob__tag {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--coral-dark);
  }

  .prob__card h3 {
    font-family: var(--font-body);
    font-size: 1.19rem;
    margin: 0.85rem 0 0;
  }

  .prob__card p {
    font-size: 0.88rem;
    line-height: 1.55;
    margin-top: 0.5rem;
  }

  @media (max-width: 56rem) {
    .prob__cards { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 40rem) {
    .prob__cards { grid-template-columns: 1fr; }
  }
</style>
