---
import { getContent, type Locale } from '../content';
import Accordion from './Accordion.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).technology;
---

<section class="sec hairtop" id="technology" aria-labelledby="technology-title">
  <div class="container">
    <SectionHeader kicker={t.kicker} title={t.title} lead={t.lead} id="technology-title" />

    {/* Process diagram: solid → heat → vapour → surface → deposition */}
    <div class="panel tech__diagram reveal">
      <svg class="tech__svg" viewBox="0 0 1080 240" role="img" aria-label={t.diagramAlt}>
        <defs>
          <linearGradient id="gv" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#F0532F" />
            <stop offset="0.55" stop-color="#6C4BD8" />
            <stop offset="1" stop-color="#C9BCF2" />
          </linearGradient>
        </defs>
        <line x1="40" y1="200" x2="330" y2="200" stroke="#26241F" stroke-width="2" />
        <rect x="150" y="176" width="70" height="24" rx="3" fill="#26241F" />
        <path d="M158 172h54" stroke="#F0532F" stroke-width="3" />
        <text x="185" y="226" font-family="IBM Plex Mono,monospace" font-size="13" fill="#57534A" text-anchor="middle">solid · m</text>
        <text x="185" y="160" font-family="IBM Plex Mono,monospace" font-size="13" fill="#C93E1E" text-anchor="middle">heat · T</text>
        <g class="tech__vapour" stroke="url(#gv)" stroke-width="2.4" fill="none" stroke-linecap="round">
          <path d="M400 200 C 420 150, 400 110, 430 60" />
          <path d="M460 200 C 480 150, 455 105, 490 55" />
          <path d="M520 200 C 540 150, 515 110, 548 60" />
        </g>
        <text x="472" y="34" font-family="IBM Plex Mono,monospace" font-size="13" fill="#5638B8" text-anchor="middle">vapour · P, t</text>
        <path d="M620 120 h150" stroke="#57534A" stroke-width="1.4" stroke-dasharray="5 5" />
        <path d="M620 112v16M770 112v16" stroke="#57534A" stroke-width="1.4" />
        <text x="695" y="106" font-family="IBM Plex Mono,monospace" font-size="13" fill="#26241F" text-anchor="middle">d · adjustable</text>
        <line x1="640" y1="200" x2="1040" y2="200" stroke="#26241F" stroke-width="2" />
        <g fill="#6C4BD8">
          <circle cx="820" cy="194" r="4" /><circle cx="844" cy="194" r="4" /><circle cx="868" cy="194" r="4" /><circle cx="892" cy="194" r="4" /><circle cx="916" cy="194" r="4" />
        </g>
        <g fill="#C9BCF2">
          <circle cx="832" cy="184" r="4" /><circle cx="856" cy="184" r="4" /><circle cx="880" cy="184" r="4" /><circle cx="904" cy="184" r="4" />
        </g>
        <text x="880" y="226" font-family="IBM Plex Mono,monospace" font-size="13" fill="#57534A" text-anchor="middle">deposited layer</text>
      </svg>
      <div class="tech__cap" aria-hidden="true">
        {t.diagramCaption.map((c) => (
          <span>{c}</span>
        ))}
      </div>
    </div>

    <ol class="tech__steps" role="list">
      {t.steps.map((step, i) => (
        <li class="tech__step reveal">
          <span class="tech__sn" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>

    <div class="tech__facts">
      {/* PLACEHOLDER photography from the design source */}
      <img class="tech__img reveal" src="/img/tech-detail.jpg" alt={t.factImgAlt} width="800" height="464" loading="lazy" />
      {t.facts.map((f) => (
        <div class="panel tech__fact reveal">
          <div class="tech__fv">{f.value}</div>
          <p>{f.text}</p>
        </div>
      ))}
    </div>

    <Accordion title={t.accordionTitle} items={t.accordion} idPrefix="tech" />

    <div class="tech__ctaband reveal">
      <p>{t.ctaBandText}</p>
      <a class="btn" href="#waitlist" data-cta-source="technology">{t.ctaBandButton}</a>
    </div>
  </div>
</section>

<style>
  .tech__diagram {
    margin-top: 3rem;
    padding: 2.5rem 2.5rem 0;
    overflow: hidden;
  }

  .tech__svg {
    width: 100%;
    height: auto;
  }

  .tech__cap {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0.25rem 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-body);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tech__vapour path {
      stroke-dasharray: 4 7;
      animation: tech-rise 2.6s linear infinite;
    }

    @keyframes tech-rise {
      to { stroke-dashoffset: -22; }
    }
  }

  .tech__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
  }

  .tech__step {
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
  }

  .tech__sn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--violet-dark);
  }

  .tech__step h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    margin: 0.4rem 0 0;
  }

  .tech__step p {
    font-size: 0.88rem;
    margin-top: 0.4rem;
  }

  .tech__facts {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr 1fr;
    gap: 1.5rem;
    margin-top: 3rem;
    align-items: stretch;
  }

  .tech__img {
    width: 100%;
    height: 100%;
    min-height: 140px;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .tech__fact {
    padding: 1.5rem;
  }

  .tech__fv {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--ink);
  }

  .tech__fact p {
    font-size: 0.88rem;
    margin-top: 0.4rem;
  }

  .tech__ctaband {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding: 1.75rem 2rem;
    background: var(--bg-inverse);
    border-radius: var(--radius-md);
  }

  .tech__ctaband p {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--text-on-dark);
  }

  @media (max-width: 56rem) {
    .tech__steps { grid-template-columns: 1fr 1fr; }
    .tech__facts { grid-template-columns: 1fr 1fr; }
    .tech__diagram { padding: 1.5rem 1.25rem 0; }
  }

  @media (max-width: 40rem) {
    .tech__steps,
    .tech__facts { grid-template-columns: 1fr; }
    .tech__ctaband { flex-direction: column; align-items: flex-start; }
    .tech__cap { flex-wrap: wrap; }
  }
</style>
