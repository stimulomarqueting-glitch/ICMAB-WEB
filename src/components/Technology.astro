---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { getContent, type Locale } from '../content';
import Accordion from './Accordion.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).technology;

/**
 * VIDEO SLOT — auto-activates at build time.
 * Drop the device video at public/video/sublimat-subtitles.mp4 and rebuild:
 * the placeholder below is replaced by a native <video> player.
 */
const VIDEO_SRC = '/video/sublimat-subtitles.mp4';
const hasVideo = existsSync(fileURLToPath(new URL(`../../public${VIDEO_SRC}`, import.meta.url)));
---

<section class="sec hairtop" id="technology" aria-labelledby="technology-title">
  <div class="container">
    <SectionHeader kicker={t.kicker} title={t.title} lead={t.lead} id="technology-title" />

    <figure class="tech__media reveal">
      {hasVideo ? (
        <video
          class="tech__video"
          controls
          preload="metadata"
          poster="/img/tech-detail.jpg"
          src={VIDEO_SRC}
        ></video>
      ) : (
        <div class="tech__video-ph" role="img" aria-label={t.video.placeholder}>
          <span class="tech__video-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M10 8.5v7l6-3.5-6-3.5Z"></path>
            </svg>
            {t.video.placeholder}
          </span>
        </div>
      )}
      <figcaption class="tech__media-cap">{t.video.caption}</figcaption>
    </figure>

    <ol class="tech__steps" role="list">
      {t.steps.map((step, i) => (
        <li class="tech__step reveal">
          <span class="tech__sn" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>

    <Accordion title={t.accordionTitle} items={t.accordion} idPrefix="tech" />

    <div class="tech__ctaband reveal">
      <p>{t.ctaBandText}</p>
      <a class="btn" href="#waitlist" data-cta-source="technology">{t.ctaBandButton}</a>
    </div>
  </div>
</section>

<style>
  .tech__media {
    margin: 2.25rem 0 0;
  }

  .tech__video,
  .tech__video-ph {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background: var(--bg-inverse);
    display: block;
    object-fit: cover;
  }

  .tech__video-ph {
    position: relative;
    background:
      linear-gradient(rgba(29, 27, 36, 0.55), rgba(29, 27, 36, 0.75)),
      url('/img/tech-detail.jpg') center / cover;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tech__video-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid rgba(248, 246, 243, 0.35);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    background: rgba(29, 27, 36, 0.45);
  }

  .tech__video-badge svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .tech__media-cap {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .tech__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  .tech__step {
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
  }

  .tech__sn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--violet-dark);
  }

  .tech__step h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    margin: 0.4rem 0 0;
  }

  .tech__step p {
    font-size: 0.88rem;
    margin-top: 0.4rem;
  }

  /* CTASection (design system): dark panel with the process strip on its
     bottom edge — a conversion moment framed as process narrative */
  .tech__ctaband {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding: 1.75rem 2rem 2.1rem;
    background: var(--bg-inverse);
    border-radius: 16px;
  }

  .tech__ctaband::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
    background: var(--grad-vapor);
  }

  .tech__ctaband p {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--text-on-dark);
  }

  @media (max-width: 56rem) {
    .tech__steps { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 40rem) {
    .tech__steps { grid-template-columns: 1fr; }
    .tech__ctaband { flex-direction: column; align-items: flex-start; }
  }
</style>
