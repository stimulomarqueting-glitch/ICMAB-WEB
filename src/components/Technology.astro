---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { getContent, type Locale } from '../content';
import Accordion from './Accordion.astro';
import BrandMark from './BrandMark.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale).technology;

/* items flagged published: false (e.g. Validation & IP pending Technology
   Transfer sign-off) stay in the content files but are not rendered */
const accordionItems = t.accordion.filter((item) => item.published !== false);

/**
 * VIDEO SLOT — auto-activates at build time.
 * Drop the device video at public/video/sublimat-subtitles.mp4 and rebuild:
 * the placeholder below is replaced by a native <video> player.
 */
const VIDEO_SRC = '/video/sublimat-subtitles.mp4';
const hasVideo = existsSync(fileURLToPath(new URL(`../../public${VIDEO_SRC}`, import.meta.url)));
---

<section class="sec hairtop mist--violet" id="technology" aria-labelledby="technology-title">
  <div class="container">
    <SectionHeader kicker={t.kicker} title={t.title} lead={t.lead} id="technology-title" />

    <figure class="tech__media reveal">
      {hasVideo ? (
        <div class="tech__videobox">
          <video class="tech__video" controls preload="none" src={VIDEO_SRC} playsinline></video>
          {/* branded facade: capsule logo + play button; removed on first play */}
          <button class="tech__poster" type="button" id="tech-video-poster" aria-label={t.video.playLabel}>
            <BrandMark size={120} />
            <span class="tech__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8.5 6.2v11.6c0 .8.9 1.3 1.6.9l9.2-5.8c.6-.4.6-1.4 0-1.8L10.1 5.3c-.7-.4-1.6.1-1.6.9Z"></path></svg>
            </span>
          </button>
        </div>
      ) : (
        <div class="tech__video-ph" role="img" aria-label={t.video.placeholder}>
          <span class="tech__video-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M10 8.5v7l6-3.5-6-3.5Z"></path>
            </svg>
            {t.video.placeholder}
          </span>
        </div>
      )}
      <figcaption class="tech__media-cap">{t.video.caption}</figcaption>
    </figure>

    <ol class="tech__steps" role="list">
      {t.steps.map((step, i) => (
        <li class="tech__step reveal">
          <span class="tech__sn" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>

    <Accordion title={t.accordionTitle} items={accordionItems} idPrefix="tech" />

    <div class="tech__ctaband reveal">
      <p>{t.ctaBandText}</p>
      <a class="btn btn--grad" href="#waitlist" data-cta-source="technology">{t.ctaBandButton}</a>
    </div>
  </div>
</section>

<script>
  // Branded video facade: first click removes the poster and starts playback.
  const poster = document.getElementById('tech-video-poster');
  const video = document.querySelector<HTMLVideoElement>('.tech__video');

  if (poster && video) {
    poster.addEventListener('click', () => {
      poster.remove();
      video.play();
    });
  }
</script>

<style>
  .tech__media {
    margin: 2.25rem 0 0;
  }

  .tech__video,
  .tech__video-ph {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background: var(--bg-inverse);
    display: block;
    object-fit: cover;
  }

  .tech__videobox {
    position: relative;
  }

  /* branded video facade: plum background + vapour glow + capsule + play */
  .tech__poster {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    width: 100%;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background:
      var(--glow-vapor),
      var(--bg-inverse);
    cursor: pointer;
    transition: background-color var(--dur-base) var(--ease);
  }

  .tech__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    background: var(--coral);
    color: #fff;
    transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .tech__play svg {
    width: 1.9rem;
    height: 1.9rem;
    margin-left: 0.2rem;
  }

  .tech__poster:hover .tech__play {
    background: var(--coral-dark);
    transform: scale(1.05);
  }

  .tech__poster:focus-visible {
    outline: 3px solid var(--violet);
    outline-offset: 3px;
  }

  @media (max-width: 40rem) {
    .tech__poster {
      gap: 1rem;
    }

    .tech__poster :global(svg[viewBox='0 0 64 96']) {
      height: 80px;
      width: auto;
    }

    .tech__play {
      width: 3.5rem;
      height: 3.5rem;
    }
  }

  .tech__video-ph {
    position: relative;
    background:
      linear-gradient(rgba(29, 27, 36, 0.55), rgba(29, 27, 36, 0.75)),
      url('/img/tech-detail.jpg') center / cover;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tech__video-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid rgba(248, 246, 243, 0.35);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    background: rgba(29, 27, 36, 0.45);
  }

  .tech__video-badge svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .tech__media-cap {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .tech__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  /* process cards (v3): white card, phase-coloured 8px bar on top */
  .tech__step {
    position: relative;
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 1.35rem 1.35rem 1.45rem;
    overflow: hidden;
  }

  .tech__step::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 8px;
    background: var(--grad-vapor-line);
  }

  /* the bar walks the sublimation: solid → heating → vapour → layer */
  .tech__step:nth-child(1)::before { background: var(--coral); }
  .tech__step:nth-child(2)::before { background: linear-gradient(90deg, var(--coral), var(--magenta)); }
  .tech__step:nth-child(3)::before { background: linear-gradient(90deg, var(--magenta), var(--violet)); }
  .tech__step:nth-child(4)::before { background: var(--violet); }

  .tech__sn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--violet-dark);
  }

  .tech__step h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    margin: 0.4rem 0 0;
  }

  .tech__step p {
    font-size: 0.88rem;
    margin-top: 0.4rem;
  }

  /* CTASection (design system): dark panel with the process strip on its
     bottom edge — a conversion moment framed as process narrative */
  .tech__ctaband {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding: 1.75rem 2rem 2.2rem;
    background: var(--bg-inverse);
    border-radius: var(--radius-xl);
  }

  .tech__ctaband::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8px;
    background: var(--grad-vapor);
  }

  .tech__ctaband p {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--text-on-dark);
  }

  @media (max-width: 56rem) {
    .tech__steps { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 40rem) {
    .tech__steps { grid-template-columns: 1fr; }
    .tech__ctaband { flex-direction: column; align-items: flex-start; }
  }
</style>
