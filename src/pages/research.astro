---
/**
 * /research — research and validation: expert experiences, publications
 * and (when Technology Transfer approves the copy) validation & IP.
 * Every block renders only when it has published content — no fillers,
 * no "coming soon".
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import PageCTA from '../components/PageCTA.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/brand';
import { expertExperiences, publications, validationItems, researchPage } from '../content/research';

const experiences = expertExperiences
  .filter((e) => e.published)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

const papers = publications
  .filter((p) => p.published)
  .sort((a, b) => b.year - a.year || (a.order ?? 0) - (b.order ?? 0));

const validation = validationItems.filter((v) => v.published);

/* ScholarlyArticle JSON-LD only for confirmed publications */
const papersJsonLd = papers.map((p) => ({
  '@type': 'ScholarlyArticle',
  headline: p.title,
  author: p.authors,
  datePublished: String(p.year),
  ...(p.doi ? { sameAs: `https://doi.org/${p.doi}` } : {}),
}));
---

<BaseLayout
  title={researchPage.metaTitle}
  description={researchPage.metaDescription}
  breadcrumb="Case Studies"
  jsonLdExtra={papersJsonLd}
>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <PageHero kicker={researchPage.kicker} title={researchPage.title} lead={researchPage.lead} />

    {experiences.length > 0 && (
      <section aria-labelledby="experiences-title" class="sec hairtop">
        <div class="container">
          <h2 class="research__head" id="experiences-title">{researchPage.experiencesTitle}</h2>
          <div class="research__grid">
            {experiences.map((e) => (
              <article class="panel research__card reveal">
                <span class="research__field">{e.field}</span>
                <blockquote class="research__quote"><p>“{e.quote}”</p></blockquote>
                <p class="research__who">
                  <strong>{e.name}</strong> · {e.role}, {e.institution}
                </p>
                {e.device && <p class="research__device">{e.device}</p>}
                {e.link && <a class="research__link" href={e.link} target="_blank" rel="noopener">More about this experience</a>}
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {papers.length > 0 && (
      <section aria-labelledby="publications-title" class="sec hairtop" id="publications">
        <div class="container">
          <h2 class="research__head" id="publications-title">{researchPage.publicationsTitle}</h2>
          <ul class="research__pubs" role="list">
            {papers.map((p) => (
              <li class="research__pub reveal">
                <h3>{p.url ? <a href={p.url} target="_blank" rel="noopener">{p.title}</a> : p.title}</h3>
                <p class="research__meta">
                  {p.authors} · <em>{p.journal}</em>, {p.year}
                  {p.doi && <span class="research__doi"> · DOI: {p.doi}</span>}
                </p>
                {p.description && <p class="research__desc">{p.description}</p>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {validation.length > 0 && (
      <section aria-labelledby="validation-title" class="sec hairtop mist--violet" id="validation">
        <div class="container">
          <h2 class="research__head" id="validation-title">{validation[0].title}</h2>
          {validation.map((v) => (
            <div class="panel research__validation reveal">
              <p>{v.text}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="sec hairtop" aria-labelledby="invite-title">
      <div class="container">
        <div class="panel page__contact reveal">
          <h2 id="invite-title">{researchPage.inviteTitle}</h2>
          <p>
            {researchPage.inviteText}
            <a href={`mailto:${brand.contactEmail}`}>{brand.contactEmail}</a>
          </p>
        </div>
      </div>
    </section>

    <PageCTA
      title={researchPage.finalCta.title}
      text={researchPage.finalCta.text}
      button={researchPage.finalCta.button}
      href={researchPage.finalCta.href}
      ctaSource="research-final"
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  .research__head {
    font-size: 1.35rem;
  }

  .research__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .research__card {
    padding: 1.75rem;
  }

  .research__field {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--violet-dark);
  }

  .research__quote {
    margin: 0.9rem 0 0;
  }

  .research__quote p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-strong);
  }

  .research__who {
    font-size: 0.88rem;
    margin-top: 0.9rem;
  }

  .research__device {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.3rem;
  }

  .research__link {
    display: inline-block;
    margin-top: 0.7rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .research__pubs {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .research__pub {
    padding: 1.25rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .research__pub h3 {
    font-family: var(--font-body);
    font-size: 1.06rem;
  }

  .research__meta {
    font-size: 0.88rem;
    margin-top: 0.4rem;
  }

  .research__doi {
    font-family: var(--font-mono);
    font-size: 0.81rem;
  }

  .research__desc {
    font-size: 0.88rem;
    margin-top: 0.4rem;
    max-width: 68ch;
  }

  .research__validation {
    margin-top: 1.5rem;
    padding: 1.75rem 2rem;
    border-color: var(--border-violet-soft);
  }

  .research__validation p {
    font-size: 0.94rem;
    line-height: 1.65;
    max-width: 70ch;
  }

  .page__contact {
    padding: 1.75rem 2rem;
    max-width: 34rem;
  }

  .page__contact h2 {
    font-size: 1.19rem;
  }

  .page__contact p {
    font-size: 0.94rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 56rem) {
    .research__grid { grid-template-columns: 1fr; }
  }
</style>
