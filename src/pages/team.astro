---
/**
 * /team — the people behind the device, grouped when groups apply.
 * Only `published: true` profiles render; no invented bios or photos.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import PageCTA from '../components/PageCTA.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/brand';
import { SITE_URL } from '../config/site.mjs';
import { teamMembers, teamGroups, teamPage } from '../content/team';

const members = teamMembers
  .filter((m) => m.published)
  .sort((a, b) => a.order - b.order);

/* groups that actually have published members, in configured order;
   ungrouped members render in a single list after them */
const grouped = teamGroups
  .map((g) => ({ ...g, members: members.filter((m) => m.group === g.key) }))
  .filter((g) => g.members.length > 0);
const ungrouped = members.filter((m) => !m.group || !teamGroups.some((g) => g.key === m.group));

/* Person JSON-LD only for published profiles — never invented */
const peopleJsonLd = members.map((m) => ({
  '@type': 'Person',
  name: m.name,
  jobTitle: m.role,
  affiliation: m.affiliation,
  ...(m.linkedin ? { sameAs: m.linkedin } : {}),
  worksFor: { '@id': `${SITE_URL}/#organization` },
}));
---

<BaseLayout title={teamPage.metaTitle} description={teamPage.metaDescription} breadcrumb="Team" jsonLdExtra={peopleJsonLd}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <PageHero kicker={teamPage.kicker} title={teamPage.title} lead={teamPage.lead} />

    {(grouped.length > 0 || ungrouped.length > 0) && (
      <section class="sec hairtop" aria-label="Team profiles">
        <div class="container">
          {grouped.map((g) => (
            <div class="team__group" id={g.key}>
              <h2 class="team__group-title">{g.title}</h2>
              <div class="team__grid">
                {g.members.map((m) => (
                  <article class="panel team__card reveal">
                    {m.image && <img class="team__photo" src={m.image} alt={`${m.name} — ${m.role}`} loading="lazy" width="400" height="400" />}
                    <h3>{m.name}</h3>
                    <p class="team__role">{m.role}</p>
                    <p class="team__affiliation">{m.affiliation}</p>
                    {m.bio && <p class="team__bio">{m.bio}</p>}
                    <div class="team__links">
                      {m.linkedin && <a href={m.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
                      {m.website && <a href={m.website} target="_blank" rel="noopener">Website</a>}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}

          {ungrouped.length > 0 && (
            <div class="team__grid team__group">
              {ungrouped.map((m) => (
                <article class="panel team__card reveal">
                  {m.image && <img class="team__photo" src={m.image} alt={`${m.name} — ${m.role}`} loading="lazy" width="400" height="400" />}
                  <h3>{m.name}</h3>
                  <p class="team__role">{m.role}</p>
                  <p class="team__affiliation">{m.affiliation}</p>
                  {m.bio && <p class="team__bio">{m.bio}</p>}
                  <div class="team__links">
                    {m.linkedin && <a href={m.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
                    {m.website && <a href={m.website} target="_blank" rel="noopener">Website</a>}
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <section class="sec hairtop" aria-labelledby="team-contact-title">
      <div class="container">
        <div class="panel page__contact reveal">
          <h2 id="team-contact-title">{teamPage.contactTitle}</h2>
          <p>
            {teamPage.contactText}
            <a href={`mailto:${brand.contactEmail}`}>{brand.contactEmail}</a>
          </p>
        </div>
      </div>
    </section>

    <PageCTA
      title={teamPage.finalCta.title}
      text={teamPage.finalCta.text}
      button={teamPage.finalCta.button}
      href={teamPage.finalCta.href}
      ctaSource="team-final"
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  .team__group {
    margin-top: 1rem;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .team__group + .team__group {
    margin-top: 2.75rem;
  }

  .team__group-title {
    font-size: 1.35rem;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .team__card {
    padding: 1.75rem;
  }

  .team__photo {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: 1.1rem;
  }

  .team__card h3 {
    font-family: var(--font-body);
    font-size: 1.19rem;
  }

  .team__role {
    font-size: 0.94rem;
    color: var(--text-strong);
    margin-top: 0.25rem;
  }

  .team__affiliation {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-top: 0.35rem;
  }

  .team__bio {
    font-size: 0.88rem;
    margin-top: 0.7rem;
  }

  .team__links {
    display: flex;
    gap: 1rem;
    margin-top: 0.8rem;
  }

  .team__links a {
    font-size: 0.88rem;
    font-weight: 600;
  }

  .page__contact {
    padding: 1.75rem 2rem;
    max-width: 34rem;
  }

  .page__contact h2 {
    font-size: 1.19rem;
  }

  .page__contact p {
    font-size: 0.94rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 56rem) {
    .team__grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 40rem) {
    .team__grid { grid-template-columns: 1fr; }
  }
</style>
