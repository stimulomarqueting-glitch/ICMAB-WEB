---
/**
 * /product — the main explanation page for the device and the technology.
 * Order: hero → what it is → key differentiator (distance FIRST, with more
 * weight) → how it works (video + steps) → parameters → benefits → FAQ
 * → final CTA.
 */
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Benefits from '../components/Benefits.astro';
import Accordion from '../components/Accordion.astro';
import BrandMark from '../components/BrandMark.astro';
import PageCTA from '../components/PageCTA.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/brand';
import { SITE_URL } from '../config/site.mjs';
import { product } from '../content/product';

const faqItems = product.faq.items.filter((item) => item.published !== false);

const VIDEO_SRC = '/video/matsurfer-device.mp4';
const hasVideo = existsSync(fileURLToPath(new URL(`../../public${VIDEO_SRC}`, import.meta.url)));

const productJsonLd = [
  {
    '@type': 'Product',
    name: brand.projectName,
    description: product.meta.description,
    brand: { '@id': `${SITE_URL}/#organization` },
    category: 'Laboratory equipment (research prototype, technology transfer phase)',
  },
];
---

<BaseLayout title={product.meta.title} description={product.meta.description} breadcrumb="Product" jsonLdExtra={productJsonLd}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <PageHero
      kicker={product.hero.kicker}
      title={product.hero.title}
      lead={product.hero.lead}
      cta={{ label: product.hero.cta, href: product.hero.ctaHref, ctaSource: 'product-hero' }}
      photo={{ src: '/img/product-table.jpg', alt: product.hero.photoAlt }}
    />

    {/* what it is */}
    <section class="sec hairtop" id="what-it-is" aria-labelledby="what-title">
      <div class="container">
        <SectionHeader
          kicker={product.whatItIs.kicker}
          title={product.whatItIs.title}
          lead={product.whatItIs.lead}
          id="what-title"
        />
      </div>
    </section>

    {/* key differentiator: distance first, larger hierarchy */}
    <section class="sec hairtop mist--violet" id="differentiator" aria-labelledby="diff-title">
      <div class="container">
        <p class="eyebrow reveal">{product.differentiator.kicker}</p>
        <div class="diff__hero panel reveal">
          <div class="diff__d" aria-hidden="true">
            <span class="mono">d</span>
            <span class="diff__d-line"></span>
          </div>
          <div>
            <h2 class="diff__title" id="diff-title">{product.differentiator.title}</h2>
            <p class="diff__text">{product.differentiator.text}</p>
          </div>
        </div>
        <div class="diff__grid">
          {product.differentiator.features.map((feat) => (
            <div class="diff__feature reveal">
              <h3>{feat.title}</h3>
              <p>{feat.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* how it works: video + four process steps */}
    <section class="sec hairtop" id="how-it-works" aria-labelledby="how-title">
      <div class="container">
        <SectionHeader kicker={product.howItWorks.kicker} title={product.howItWorks.title} id="how-title" />

        <figure class="tech__media reveal">
          {hasVideo ? (
            <div class="tech__videobox">
              <video class="tech__video" controls preload="none" src={VIDEO_SRC} playsinline></video>
              {/* branded facade: capsule logo + play button; removed on first play */}
              <button class="tech__poster" type="button" id="tech-video-poster" aria-label={product.howItWorks.video.playLabel}>
                <BrandMark size={120} />
                <span class="tech__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8.5 6.2v11.6c0 .8.9 1.3 1.6.9l9.2-5.8c.6-.4.6-1.4 0-1.8L10.1 5.3c-.7-.4-1.6.1-1.6.9Z"></path></svg>
                </span>
              </button>
            </div>
          ) : (
            <div class="tech__video-ph" role="img" aria-label={product.howItWorks.video.placeholder}>
              <span class="tech__video-badge">{product.howItWorks.video.placeholder}</span>
            </div>
          )}
          <figcaption class="tech__media-cap">{product.howItWorks.video.caption}</figcaption>
        </figure>

        <ol class="tech__steps" role="list">
          {product.howItWorks.steps.map((step, i) => (
            <li class="tech__step reveal">
              <span class="tech__sn" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* parameters */}
    <section class="sec hairtop mist" id="parameters" aria-labelledby="params-title">
      <div class="container">
        <SectionHeader
          kicker={product.parameters.kicker}
          title={product.parameters.title}
          lead={product.parameters.lead}
          id="params-title"
        />
        <ul class="params__grid reveal" role="list">
          {product.parameters.items.map((p) => (
            <li class="params__card">
              <span class="params__symbol mono">{p.symbol}</span>
              <span class="params__label">{p.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Benefits
      kicker={product.benefits.kicker}
      title={product.benefits.title}
      outcomes={product.benefits.outcomes}
      id="product-benefits-title"
    />

    {/* FAQ */}
    <section class="sec hairtop" id="faq" aria-labelledby="faq-title">
      <div class="container">
        <SectionHeader kicker={product.faq.kicker} title={product.faq.title} id="faq-title" />
        <Accordion items={faqItems} idPrefix="faq" />
      </div>
    </section>

    <PageCTA
      title={product.finalCta.title}
      text={product.finalCta.text}
      button={product.finalCta.button}
      href={product.finalCta.href}
      ctaSource="product-final"
    />
  </main>
  <Footer />
</BaseLayout>

<script>
  // Branded video facade: first click removes the poster and starts playback.
  const poster = document.getElementById('tech-video-poster');
  const video = document.querySelector<HTMLVideoElement>('.tech__video');

  if (poster && video) {
    poster.addEventListener('click', () => {
      poster.remove();
      video.play();
    });
  }
</script>

<style>
  /* ── key differentiator ──────────────────────────────────────────────── */
  .diff__hero {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    margin-top: 1.25rem;
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    border-color: var(--border-violet-soft);
  }

  /* the distance "d" drawn as an instrument annotation */
  .diff__d {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .diff__d .mono {
    font-size: 2rem;
    font-weight: 600;
    color: var(--violet-dark);
  }

  .diff__d-line {
    width: 2px;
    height: 4.5rem;
    background: var(--grad-vapor-rise);
    border-radius: 2px;
    position: relative;
  }

  .diff__d-line::before,
  .diff__d-line::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 1rem;
    height: 2px;
  }

  .diff__d-line::before {
    top: 0;
    background: var(--violet);
  }

  .diff__d-line::after {
    bottom: 0;
    background: var(--coral);
  }

  .diff__title {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
  }

  .diff__text {
    margin-top: 0.75rem;
    font-size: 1.06rem;
    line-height: 1.55;
    max-width: 58ch;
  }

  .diff__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 2.5rem;
    margin-top: 2.25rem;
  }

  .diff__feature {
    border-top: 1px solid var(--border-violet-soft);
    padding-top: 1rem;
  }

  .diff__feature h3 {
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .diff__feature p {
    font-size: 0.88rem;
    margin-top: 0.4rem;
  }

  /* ── how it works (video + steps, v3 process cards) ──────────────────── */
  .tech__media {
    margin: 2.25rem 0 0;
  }

  .tech__video,
  .tech__video-ph {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background: var(--bg-inverse);
    display: block;
    object-fit: cover;
  }

  .tech__videobox {
    position: relative;
  }

  .tech__poster {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    width: 100%;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background:
      var(--glow-vapor),
      var(--bg-inverse);
    cursor: pointer;
    transition: background-color var(--dur-base) var(--ease);
  }

  .tech__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    background: var(--coral);
    color: #fff;
    transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .tech__play svg {
    width: 1.9rem;
    height: 1.9rem;
    margin-left: 0.2rem;
  }

  .tech__poster:hover .tech__play {
    background: var(--coral-dark);
    transform: scale(1.05);
  }

  .tech__poster:focus-visible {
    outline: 3px solid var(--violet);
    outline-offset: 3px;
  }

  .tech__video-ph {
    position: relative;
    background:
      linear-gradient(rgba(35, 21, 54, 0.55), rgba(35, 21, 54, 0.75)),
      url('/img/tech-detail.jpg') center / cover;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tech__video-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid rgba(248, 246, 243, 0.35);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    background: rgba(35, 21, 54, 0.45);
  }

  .tech__media-cap {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .tech__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  /* process cards (v3): white card, phase-coloured 8px bar on top */
  .tech__step {
    position: relative;
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 1.35rem 1.35rem 1.45rem;
    overflow: hidden;
  }

  .tech__step::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 8px;
    background: var(--grad-vapor-line);
  }

  /* the bar walks the sublimation: solid → heating → vapour → layer */
  .tech__step:nth-child(1)::before { background: var(--coral); }
  .tech__step:nth-child(2)::before { background: linear-gradient(90deg, var(--coral), var(--magenta)); }
  .tech__step:nth-child(3)::before { background: linear-gradient(90deg, var(--magenta), var(--violet)); }
  .tech__step:nth-child(4)::before { background: var(--violet); }

  .tech__sn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--violet-dark);
  }

  .tech__step h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    margin: 0.4rem 0 0;
  }

  .tech__step p {
    font-size: 0.88rem;
    margin-top: 0.4rem;
  }

  /* ── parameters ──────────────────────────────────────────────────────── */
  .params__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  .params__card {
    background: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .params__symbol {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--violet-dark);
  }

  .params__card:first-child {
    background: var(--violet-tint);
    border-color: var(--border-violet-soft);
  }

  .params__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* ── responsive ──────────────────────────────────────────────────────── */
  @media (max-width: 56rem) {
    .diff__grid { grid-template-columns: 1fr 1fr; }
    .tech__steps { grid-template-columns: 1fr 1fr; }
    .params__grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 40rem) {
    .diff__hero {
      flex-direction: column;
      align-items: flex-start;
    }

    .diff__d {
      flex-direction: row;
    }

    .diff__d-line {
      width: 4.5rem;
      height: 2px;
      background: var(--grad-vapor-line);
    }

    .diff__d-line::before {
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 2px;
      height: 1rem;
    }

    .diff__d-line::after {
      left: auto;
      right: 0;
      bottom: auto;
      top: 50%;
      transform: translateY(-50%);
      width: 2px;
      height: 1rem;
    }

    .diff__grid { grid-template-columns: 1fr; }
    .tech__steps { grid-template-columns: 1fr; }
    .params__grid { grid-template-columns: 1fr 1fr; }
  }
</style>
