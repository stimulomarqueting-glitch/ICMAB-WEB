---
/**
 * /team — the people behind the device: full-viewport showcase, then the
 * "from the lab to the bench" section, contact panel and final CTA.
 * Only `published: true` profiles render; no invented bios or photos.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import PageCTA from '../../components/PageCTA.astro';
import TeamShowcase from '../../components/TeamShowcase.astro';
import TeamJourney from '../../components/TeamJourney.astro';
import Footer from '../../components/Footer.astro';
import { brand } from '../../config/brand';
import { SITE_URL } from '../../config/site.mjs';
import { getContent } from '../../content';
import { getLocale, localeStaticPaths } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const { teamMembers, teamPage, site } = getContent(getLocale(Astro.url));

const members = teamMembers
  .filter((m) => m.published)
  .sort((a, b) => a.order - b.order);

/* Person JSON-LD only for published profiles — never invented */
const peopleJsonLd = members.map((m) => ({
  '@type': 'Person',
  name: m.name,
  jobTitle: m.role,
  affiliation: m.affiliation,
  ...(m.linkedin ? { sameAs: m.linkedin } : {}),
  worksFor: { '@id': `${SITE_URL}/#organization` },
}));
---

<BaseLayout title={teamPage.metaTitle} description={teamPage.metaDescription} breadcrumb={teamPage.breadcrumb} jsonLdExtra={peopleJsonLd}>
  <a class="skip-link" href="#main">{site.a11y.skipToContent}</a>
  <Header />
  <main id="main">
    {/* full-viewport showcase carries the h1; the plain hero is the no-profile fallback */}
    {members.length > 0 ? (
      <TeamShowcase members={members} />
    ) : (
      <PageHero kicker={teamPage.kicker} title={teamPage.title} lead={teamPage.lead} />
    )}

    <TeamJourney />

    <section class="sec hairtop" aria-labelledby="team-contact-title">
      <div class="container">
        <div class="panel page__contact reveal">
          <h2 id="team-contact-title">{teamPage.contactTitle}</h2>
          <p>
            {teamPage.contactText}
            <a href={`mailto:${brand.contactEmail}`}>{brand.contactEmail}</a>
          </p>
        </div>
      </div>
    </section>

    <PageCTA
      title={teamPage.finalCta.title}
      text={teamPage.finalCta.text}
      button={teamPage.finalCta.button}
      href={teamPage.finalCta.href}
      ctaSource="team-final"
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  .page__contact {
    padding: 1.75rem 2rem;
    max-width: 34rem;
  }

  .page__contact h2 {
    font-size: 1.19rem;
  }

  .page__contact p {
    font-size: 0.94rem;
    margin-top: 0.5rem;
  }

</style>
