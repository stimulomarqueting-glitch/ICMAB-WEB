---
/**
 * /applications — help the visitor recognise their use case.
 * One horizontal block per confirmed application (need → with MatSurfer →
 * benefit), each with an anchor and a contextual contact CTA. Grows from
 * src/content/applications.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import PageCTA from '../../components/PageCTA.astro';
import Footer from '../../components/Footer.astro';
import { getContent } from '../../content';
import { getLocale, localePath, localeStaticPaths } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = getLocale(Astro.url);
const { applications, applicationsPage: t, site } = getContent(locale);
const lp = (href: string) => localePath(locale, href);

const apps = applications
  .filter((a) => a.published)
  .sort((a, b) => a.order - b.order);
---

<BaseLayout title={t.meta.title} description={t.meta.description} breadcrumb={t.meta.breadcrumb}>
  <a class="skip-link" href="#main">{site.a11y.skipToContent}</a>
  <Header />
  <main id="main">
    <PageHero
      kicker={t.hero.kicker}
      kickerNote={t.hero.kickerNote}
      title={t.hero.title}
      lead={t.hero.lead}
    />

    {/* sticky in-page nav: the five applications, the one in view highlighted */}
    <nav class="apps-nav" aria-label={t.labels.section} data-apps-nav>
      <div class="container apps-nav__inner">
        {apps.map((app) => (
          <a class="apps-nav__pill" href={`#${app.slug}`} data-target={app.slug}>{app.title}</a>
        ))}
      </div>
    </nav>

    <section class="sec hairtop" aria-label={t.labels.section}>
      <div class="container apps">
        {apps.map((app) => (
          <article class="panel app reveal" id={app.slug} aria-labelledby={`app-${app.slug}`}>
            <header class="app__head">
              <span class="app__tag">{app.tag}</span>
              <h2 id={`app-${app.slug}`}>{app.title}</h2>
            </header>
            <div class="app__cols">
              <div>
                <h3 class="app__label">{t.labels.challenge}</h3>
                <p>{app.challenge}</p>
              </div>
              <div>
                <h3 class="app__label">{t.labels.use}</h3>
                <p>{app.use}</p>
              </div>
              <div>
                <h3 class="app__label">{t.labels.benefit}</h3>
                <p>{app.benefit}</p>
              </div>
            </div>
            <a
              class="btn btn--ghost btn--sm app__cta"
              href={lp(`/contact?interest=application&application=${app.slug}`)}
              data-cta-source={`applications-${app.slug}`}
              aria-label={`${t.labels.cta} — ${app.title}`}
            >
              {t.labels.cta}
            </a>
          </article>
        ))}
      </div>
    </section>

    {/* for R&D people who don't identify as surface scientists */}
    <section class="sec broader--dark" aria-labelledby="broader-title">
      <div class="broader__glow" aria-hidden="true"></div>
      <div class="container broader">
        <div class="broader__panel reveal">
          <p class="eyebrow">{t.broader.kicker}</p>
          <h2 class="h2" id="broader-title">{t.broader.title}</h2>
          <p class="broader__text">{t.broader.text}</p>
          <span class="broader__layer" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <PageCTA
      title={t.finalCta.title}
      text={t.finalCta.text}
      button={t.finalCta.button}
      href={t.finalCta.href}
      ctaSource="applications-final"
    />
  </main>
  <Footer />
</BaseLayout>

<script>
  /* scroll-spy: the pill of the application in view is current */
  const pills = [...document.querySelectorAll<HTMLAnchorElement>('[data-apps-nav] [data-target]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.app[id]')];
  if (pills.length && cards.length && 'IntersectionObserver' in window) {
    const setCurrent = (id: string) => pills.forEach((p) => p.toggleAttribute('aria-current', p.dataset.target === id));
    const io = new IntersectionObserver(
      (entries) => {
        const hit = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (hit) setCurrent(hit.target.id);
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    cards.forEach((c) => io.observe(c));
    pills.forEach((p) => p.addEventListener('click', () => setCurrent(p.dataset.target ?? '')));
  }
</script>

<style>
  /* ── sticky application nav ─────────────────────────────────────── */
  .apps-nav {
    position: sticky;
    top: var(--header-h);
    z-index: 30;
    background: var(--glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border-bottom: 1px solid var(--border-subtle);
  }

  .apps-nav__inner {
    display: flex;
    gap: 0.5rem;
    padding-block: 0.6rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .apps-nav__inner::-webkit-scrollbar {
    display: none;
  }

  .apps-nav__pill {
    flex: none;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    font-size: 0.81rem;
    font-weight: 600;
    color: var(--text-body);
    background: var(--bg-panel);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }

  .apps-nav__pill:hover {
    color: var(--ink);
    border-color: var(--border-violet-soft);
  }

  .apps-nav__pill[aria-current] {
    color: #fff;
    background: var(--bg-inverse);
    border-color: var(--bg-inverse);
  }

  .apps {
    display: grid;
    gap: 1.5rem;
  }

  .app {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    /* anchor landing: keep the header below the sticky glass navbar */
    scroll-margin-top: calc(var(--header-h) + 4.5rem);
    transition: border-color var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease), transform var(--dur-base) var(--ease);
  }

  /* the deposited layer stands on the card's left edge and grows in on reveal */
  .app::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 4px;
    height: 0;
    background: var(--grad-vapor-rise);
    transition: height 900ms var(--ease-out);
    transition-delay: 200ms;
  }

  .app.is-visible::before {
    height: 100%;
  }

  .app:hover {
    border-color: var(--border-violet-soft);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  /* landing on an anchor from the home chips: a brief violet halo */
  .app:target {
    animation: app-land 1800ms var(--ease-out);
  }

  @keyframes app-land {
    0% { box-shadow: 0 0 0 0 rgba(108, 18, 248, 0.35); border-color: var(--violet); }
    100% { box-shadow: 0 0 0 18px rgba(108, 18, 248, 0); border-color: var(--border-subtle); }
  }

  .app__head {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .app__tag {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.04em;
    color: var(--violet-dark);
    background: var(--violet-tint);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.65rem;
  }

  .app__head h2 {
    font-size: 1.35rem;
  }

  .app__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-top: 1.5rem;
  }

  .app__label {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--coral-dark);
  }

  .app__cols p {
    font-size: 0.94rem;
    line-height: 1.55;
    margin-top: 0.5rem;
  }

  .app__cta {
    margin-top: 1.5rem;
  }

  /* ── beyond surface science: plum band, glass panel ────────────── */
  .broader--dark {
    position: relative;
    overflow: hidden;
    background: var(--bg-inverse);
    isolation: isolate;
  }

  .broader__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(45% 60% at 85% 20%, rgba(108, 18, 248, 0.28), transparent 70%),
      radial-gradient(35% 45% at 8% 100%, rgba(240, 83, 47, 0.14), transparent 70%);
  }

  .broader__panel {
    position: relative;
    overflow: hidden;
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .broader--dark :global(.eyebrow) {
    color: var(--lavender);
  }

  .broader--dark :global(.h2) {
    color: var(--text-on-dark);
  }

  .broader__text {
    margin: 1rem auto 0;
    max-width: 58ch;
    font-size: 1.06rem;
    line-height: 1.6;
    color: var(--text-on-dark-2);
  }

  /* the section header's title cap is left-aligned by default; centre it here */
  .broader--dark :global(.h2) {
    margin-inline: auto;
  }

  .broader__layer {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 0;
    background: var(--grad-vapor-line);
    box-shadow: 0 0 14px rgba(206, 66, 98, 0.55);
    transition: width 1100ms var(--ease-out) 250ms;
  }

  .broader__panel.is-visible .broader__layer {
    width: 100%;
  }

  @media (max-width: 56rem) {
    .app__cols {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  @media (max-width: 40rem) {
    .app__cta {
      width: 100%;
    }
  }
</style>
