---
/**
 * Home — strategic introduction, 8 blocks:
 * hero → value strip → product teaser → benefits → applications teaser
 * → who it's for → research/team strip → final CTA.
 * Full explanations live on /product, /applications, /research, /team.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import HeroField from '../../components/HeroField.astro';
import { heroVariant } from '../../config/hero';
import Benefits from '../../components/Benefits.astro';
import Audiences from '../../components/Audiences.astro';
import AppsIsotype from '../../components/AppsIsotype.astro';
import BrandMark from '../../components/BrandMark.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PageCTA from '../../components/PageCTA.astro';
import Footer from '../../components/Footer.astro';
import { getContent } from '../../content';
import { getLocale, localePath, localeStaticPaths } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = getLocale(Astro.url);
const { home, applications, site } = getContent(locale);
const lp = (href: string) => localePath(locale, href);

const apps = applications
  .filter((a) => a.published)
  .sort((a, b) => a.order - b.order);
---

<BaseLayout>
  <a class="skip-link" href="#main">{site.a11y.skipToContent}</a>
  <Header />
  <main id="main">
    {heroVariant === 'field' ? <HeroField /> : <Hero />}

    {/* value flow: Problem → MatSurfer → Result, one sentence each */}
    <section class="sec hairtop" aria-label={home.value.label}>
      <div class="container">
        <p class="eyebrow value__kicker reveal">{home.value.kicker}</p>
        <ol class="value" role="list">
          {home.value.items.map((item, i) => (
            <li class:list={['panel', 'value__item', 'reveal', { 'value__item--core': i === 1, 'value__item--result': i === 2 }]} style={`--i: ${i}`}>
              <div class="value__head">
                <span class="value__step">{String(i + 1).padStart(2, '0')}</span>
                {i === 1 ? (
                  <span class="value__tag value__tag--brand">
                    <BrandMark size={18} />
                    {item.tag}
                  </span>
                ) : (
                  <span class="value__tag">{item.tag}</span>
                )}
              </div>
              <p>{item.text}</p>
              {i < home.value.items.length - 1 && (
                <span class="value__arrow" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
                </span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* product teaser */}
    <section class="sec hairtop mist--violet" id="technology" aria-labelledby="product-teaser-title">
      <div class="container pt__grid">
        <div>
          <SectionHeader
            kicker={home.product.kicker}
            title={home.product.title}
            lead={home.product.lead}
            id="product-teaser-title"
          />
          <div class="pt__cta reveal">
            <a class="btn" href={lp(home.product.ctaHref)} data-cta-source="home-product">{home.product.cta}</a>
          </div>
        </div>
        <img
          class="pt__photo reveal"
          src="/img/tech-detail.jpg"
          alt={home.product.photoAlt}
          width="1000"
          height="750"
          loading="lazy"
        />
      </div>
    </section>

    <Benefits
      kicker={home.benefits.kicker}
      title={home.benefits.title}
      outcomes={home.benefits.outcomes}
    />

    {/* applications teaser: isotype + six links into /applications */}
    <section class="sec hairtop mist" id="applications" aria-labelledby="apps-teaser-title">
      <div class="container">
        <SectionHeader
          kicker={home.applications.kicker}
          title={home.applications.title}
          lead={home.applications.lead}
          id="apps-teaser-title"
        />
        <AppsIsotype
          alt={home.applications.isotype.alt}
          caption={home.applications.isotype.caption}
          labels={home.applications.isotype.labels}
        />
        <ul class="apps__links" role="list" data-apps-links>
          {apps.map((app, i) => (
            <li class="reveal" style={`--rd: ${i * 70}ms`}>
              <a class="apps__chip" href={lp(`/applications#${app.slug}`)} data-field={app.slug}>
                {app.title}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="apps__cta reveal">
          <a class="btn" href={lp(home.applications.ctaHref)} data-cta-source="home-applications">{home.applications.cta}</a>
        </div>
      </div>
    </section>

    <Audiences />

    {/* research + team strip */}
    <section class="sec hairtop explore" aria-label={`${home.explore.researchTitle} · ${home.explore.teamTitle}`}>
      <div class="container explore__grid">
        <div class="panel explore__card reveal">
          <div>
            <h2>{home.explore.researchTitle}</h2>
            <p>{home.explore.researchText}</p>
          </div>
          <a class="btn btn--ghost btn--sm" href={lp(home.explore.researchHref)} data-cta-source="home-research">{home.explore.researchCta}</a>
        </div>
        <div class="panel explore__card reveal">
          <div>
            <h2>{home.explore.teamTitle}</h2>
            <p>{home.explore.teamText}</p>
          </div>
          <a class="btn btn--ghost btn--sm" href={lp(home.explore.teamHref)} data-cta-source="home-team">{home.explore.teamCta}</a>
        </div>
      </div>
    </section>

    <PageCTA
      title={home.finalCta.title}
      text={home.finalCta.text}
      button={home.finalCta.button}
      href={home.finalCta.href}
      ctaSource="home-final"
    />
  </main>
  <Footer />
</BaseLayout>

<script>
  /* a chip under the isotype lights up its field in the figure */
  const chips = document.querySelectorAll<HTMLAnchorElement>('[data-apps-links] [data-field]');
  const callouts = document.querySelectorAll<SVGGElement>('[data-isotype] .iso__callout[data-field]');
  const setHot = (field: string | undefined, on: boolean) => {
    callouts.forEach((c) => {
      if (c.dataset.field === field) c.toggleAttribute('data-hot', on);
    });
  };
  chips.forEach((chip) => {
    const field = chip.dataset.field;
    chip.addEventListener('pointerenter', () => setHot(field, true));
    chip.addEventListener('pointerleave', () => setHot(field, false));
    chip.addEventListener('focus', () => setHot(field, true));
    chip.addEventListener('blur', () => setHot(field, false));
  });
</script>

<style>
  /* ── value flow ──────────────────────────────────────────────────── */
  .value__kicker {
    margin-bottom: 1.25rem;
  }

  .value {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .value__item {
    position: relative;
    padding: 1.5rem 1.6rem 1.6rem;
    transition-delay: calc(var(--i) * 90ms);
  }

  .value__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.9rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .value__step {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .value__tag {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--coral-dark);
  }

  .value__tag--brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--violet-dark);
  }

  .value__item p {
    font-size: 0.94rem;
    line-height: 1.55;
  }

  /* the device step carries the vapour tint and sits a touch forward */
  .value__item--core {
    background: linear-gradient(160deg, var(--violet-tint) 0%, var(--bg-panel) 70%);
    border-color: var(--border-violet-soft);
    box-shadow: var(--shadow-md);
  }

  .value__item--core .value__head {
    border-bottom-color: var(--border-violet-soft);
  }

  .value__item--core .value__step {
    color: var(--violet-dark);
  }

  /* the result ends on the deposited layer */
  .value__item--result {
    overflow: hidden;
  }

  .value__item--result::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: var(--grad-vapor-line);
  }

  .value__item--result .value__tag {
    color: var(--violet-dark);
  }

  /* arrow badge bridging the gap to the next step */
  .value__arrow {
    position: absolute;
    top: 50%;
    right: -0.75rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    transform: translate(50%, -50%);
    border-radius: 50%;
    background: var(--bg-page);
    color: var(--violet-dark);
    box-shadow: 0 0 0 1px var(--border-violet-soft), var(--shadow-sm, 0 2px 8px rgba(38, 36, 31, 0.08));
  }

  .value__arrow svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  /* ── product teaser ──────────────────────────────────────────────────── */
  .pt__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .pt__cta {
    margin-top: 1.75rem;
  }

  .pt__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--border-violet-soft);
    border-radius: var(--radius-lg);
  }

  /* ── applications teaser ─────────────────────────────────────────────── */
  .apps__links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  .apps__chip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 1.2rem;
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.94rem;
    color: var(--ink);
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), background var(--dur-base) var(--ease), transform var(--dur-fast) var(--ease), box-shadow var(--dur-base) var(--ease);
  }

  .apps__chip span {
    color: var(--coral);
    transition: transform var(--dur-fast) var(--ease);
  }

  .apps__chip:hover,
  .apps__chip:focus-visible {
    color: var(--coral-dark);
    border-color: var(--border-coral-soft);
    background: linear-gradient(120deg, var(--coral-tint) 0%, var(--bg-panel) 60%);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .apps__chip:hover span {
    transform: translateX(3px);
  }

  .apps__cta {
    margin-top: 2rem;
  }

  /* ── research + team strip ───────────────────────────────────────────── */
  .explore {
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .explore__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .explore__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 1.75rem;
  }

  .explore__card h2 {
    font-size: 1.19rem;
  }

  .explore__card p {
    font-size: 0.88rem;
    margin-top: 0.4rem;
    max-width: 34ch;
  }

  .explore__card .btn {
    flex: none;
  }

  /* ── responsive ──────────────────────────────────────────────────────── */
  @media (max-width: 56rem) {
    .value {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    /* stacked: the arrow turns to point down, centred on the gap */
    .value__arrow {
      top: auto;
      right: auto;
      bottom: -0.625rem;
      left: 50%;
      transform: translate(-50%, 50%) rotate(90deg);
    }

    .pt__grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .apps__links {
      grid-template-columns: 1fr 1fr;
    }

    .explore__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .apps__links {
      grid-template-columns: 1fr;
    }

    .explore__card {
      flex-direction: column;
      align-items: flex-start;
    }

    .explore__card .btn,
    .apps__cta .btn,
    .pt__cta .btn {
      width: 100%;
    }
  }
</style>
