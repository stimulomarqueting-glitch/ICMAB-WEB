---
/**
 * /contact — the conversion page: short intro, light lead form, and a
 * quiet "what happens next" aside. Interest preselects from URL params
 * (see LeadForm + src/content/contact.ts).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import LeadForm from '../../components/LeadForm.astro';
import Footer from '../../components/Footer.astro';
import { brand } from '../../config/brand';
import mailIcon from '../../icons/brand/mail.svg?raw';
import { getContent } from '../../content';
import { getLocale, localeStaticPaths } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const { contact, site } = getContent(getLocale(Astro.url));
---

<BaseLayout title={contact.meta.title} description={contact.meta.description} breadcrumb={contact.meta.breadcrumb}>
  <a class="skip-link" href="#main">{site.a11y.skipToContent}</a>
  <Header />
  <main id="main">
    <section class="sec contact-sec" aria-labelledby="contact-title">
      <div class="container contact">
        <div>
          <p class="eyebrow rise-in" style="--i: 0">{contact.hero.kicker}</p>
          <h1 class="contact__title" id="contact-title">
            {contact.hero.title.split(' ').map((w, i) => (
              <>
                <span class="contact__word"><span class="rise-in" style={`--i: ${i + 1}`}>{w}</span></span>{' '}
              </>
            ))}
          </h1>
          <p class="lead rise-in" style="--i: 5">{contact.hero.lead}</p>

          <div class="contact__aside reveal">
            <h2 class="contact__aside-title">{contact.aside.title}</h2>
            <ol class="contact__steps" role="list">
              {contact.aside.steps.map((step, i) => (
                <li>
                  <span class="contact__sn" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
            <h2 class="contact__aside-title contact__direct">
              <span class="contact__mail" aria-hidden="true" set:html={mailIcon} />
              {contact.aside.directTitle}
            </h2>
            <p class="contact__direct-text">
              {contact.aside.directText}
              <a href={`mailto:${brand.contactEmail}`}>{brand.contactEmail}</a>
            </p>
          </div>
        </div>

        <LeadForm />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* the subtle sublimation tint marks the conversion moment */
  .contact-sec {
    background: var(--grad-vapor-subtle), var(--bg-page);
  }

  .contact {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 4rem;
    align-items: start;
  }

  .contact__title {
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    line-height: 1.06;
    margin-top: 0.9rem;
  }

  .contact__word {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .contact__word .rise-in {
    display: inline-block;
  }

  .eyebrow.rise-in,
  .lead.rise-in {
    display: block;
  }

  .contact__aside {
    margin-top: 2.25rem;
  }

  .contact__aside-title {
    font-family: var(--font-body);
    font-size: 1.06rem;
  }

  /* the three steps as a short timeline on a vapour line */
  .contact__steps {
    position: relative;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0 0 0 2.6rem;
  }

  .contact__steps::before {
    content: '';
    position: absolute;
    top: 0.9rem;
    bottom: 0.9rem;
    left: 0.95rem;
    width: 2px;
    background: var(--grad-vapor-rise);
    opacity: 0.5;
  }

  .contact__steps li {
    position: relative;
    display: block;
    padding: 0.75rem 0;
    font-size: 0.94rem;
  }

  .contact__sn {
    position: absolute;
    left: -2.6rem;
    top: 0.55rem;
    display: grid;
    place-items: center;
    width: 1.95rem;
    height: 1.95rem;
    border-radius: 50%;
    background: var(--bg-page);
    border: 1px solid var(--border-violet-soft);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 600;
    color: var(--violet-dark);
  }

  .contact__steps li:first-child .contact__sn { color: var(--coral-dark); border-color: var(--border-coral-soft); }
  .contact__steps li:last-child .contact__sn { color: var(--violet-dark); }

  .contact__direct {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .contact__mail {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    background: var(--coral-tint);
    color: var(--coral-dark);
  }

  .contact__mail :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .contact__direct-text {
    font-size: 0.94rem;
    margin-top: 0.4rem;
  }

  .contact :global(.lf__card) {
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .contact :global(.lf__card)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--grad-vapor-line);
  }

  @media (max-width: 56rem) {
    .contact {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 40rem) {
    .contact > div:first-child > .eyebrow,
    .contact__title,
    .contact > div:first-child > .lead {
      text-align: center;
      margin-inline: auto;
    }

    .contact__aside {
      margin-top: 2.5rem;
    }
  }
</style>
